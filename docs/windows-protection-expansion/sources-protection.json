      "id": "CREDENTIAL-MANAGER",
      "sources": [
        "S11",
        "S13"
      ],
      "difference": "Broad older Vault wording versus type-specific current considerations.",
      "resolution": "Domain Windows protected; generic application credential not protected. No blanket Vault claim."
    },
