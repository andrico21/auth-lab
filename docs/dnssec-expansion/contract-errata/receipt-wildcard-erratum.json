 "adjudication": {
  "case": "DNS09/wildcard-nodata",
  "rawInputs": {
   "query": "foo.lab.example. AAAA IN",
   "responseInputs.answer": "[]",
   "responseInputs.proofs": "two NSEC proofs: next-closer cover and wildcard-owner match; wildcard bitmap has A/RRSIG/NSEC, no AAAA/CNAME",
   "responseInputs.wildcardSignature": "wildcard-a catalog A signature, not an answer receipt",
   "SOA": "received negative-cache SOA"
  },
  "rfcConclusion": "RFC 4035 sections 5.3.4/5.4 and RFC 4592 sections 2.2/3.3 require proof of no exact match plus authenticated wildcard existence/type absence. RFC 4034 section 3.1.1 uses the NSEC type bitmap. The wildcard A RRset/RRSIG is not needed and is not received; requiring numericBindings-primary:wildcard-a in validator evidence is incorrect.",
  "statusConsequence": "securityStatus=secure, rcode=NOERROR, nodata-wildcard and acceptedForUse=true remain unchanged."
 },
