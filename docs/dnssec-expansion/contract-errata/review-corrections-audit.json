  "sourceJustifiedCoordination": [
    {
      "peer": "DnsNetworkFix",
      "content": "Independent stub retains own proof/cache; anchorless resolver fetch context does not inherit local result. No verdict packet."
    },
    {
      "peer": "DnsPublishFix",
      "content": "Explicit model validation declaration5/7/13/15; actual mathematical fixture coverage13/15. Confirmed old/dual dataTTL3600, final alg15 dataTTL7200; timeline assessed against RFC6781 with actual immutable signature windows."
    },
    {
      "peer": "DnsDenialFix",
      "content": "RFC2308 NXDOMAIN name/class versus NODATA/compact/failure key distinctions; R04 independent numeric controls requested."
    }
  ],
  "decisions": {
    "R01": "InitialCache false already correct. Remove inherited resolver validated-cache statement, declare separate checking contexts; ownership and accepted sequence/checkpoint/cache checking context stay at dnsStub. Catalog holdings are not proof transfers. All other network profiles unchanged.",
    "R03": "Correct exactly3 newly inserted ordinary NXDOMAIN entries. Preserve seeded DNS10 correct name/class entry. NODATA/ENT/no-DS and compact/CO remain type-specific; failure keys retain checkingContext. Keep receipt1792713600,expiry1792713900 and signed deadline1792717200.",
    "R05": {
      "rule": "RFC6781 4.1.4: old DS withdrawal -> convergence+old DS TTL -> old DNSKEY withdrawal -> convergence+old DNSKEY TTL -> old ordinary signature withdrawal -> convergence+old data TTL. No requirement that validator verify every advertised algorithm.",
      "offsets": {
        "publish-alg13-and-alg15-ordinary-signatures": 0,
        "publish-dual-algorithm-signed-zone": 3900,
        "publish-dual-algorithm-ds": 8100,
        "parent-dual-algorithm-ds-converged": 8700,
        "select-usable-alg15-path": 8700,
        "retire-alg13-parent-ds": 95100,
        "late-old-containing-ds-cache": 95699,
        "parent-alg13-ds-converged": 95700,
        "retire-alg13-after-ds-and-child-cache-dependencies": 182100,
        "child-alg13-key-removal-converged": 182400,
        "retire-alg13-ordinary-signatures": 186000,
        "child-alg13-signature-removal-converged": 186300,
        "old-alg13-data-dependencies-ended": 189900,
        "lastOldDsReceipt": 95699,
        "lastOldDsCacheExpires": 182099,
        "oldDsDependencyEnds": 182100,
        "oldDnskeyDependencyEnds": 186000,
        "ordinaryDataDependencyEnds": 189900
      },
      "lateOldAlgorithmOnlyCohort": {
        "receivedAt": 1792809299,
        "expiresAt": 1792895699,
        "supports": [
          13
        ],
        "at95701": "secure while the old key and signatures remain",
        "at182100": "old cache expired; fresh alg15-only DS is insecure for this profile, not bogus"
      },
      "freshOldAlgorithmOnlyCohort": "Fresh alg15-only DS after withdrawal is unsupported/insecure under the explicit13-only capability control.",
      "dualCapableCohort": "A supported alg15 path remains usable through all stages.",
      "fixtureValidity": "Referenced complete-path/long-profile RRSIG inception1792713000 and expiration1803081600 enclose final observation1792903500. All exact tuples unchanged.",
      "inheritedSetupRepair": "maximumZoneTtl7200 is replaced by represented old/dual ordinary TTL3600; final alg15-only TTL7200 separately declared. Base one-hour signatures are catalog only, not chosen later validation evidence."
    },
    "R06": "Registry MUST implementation support is not installed capability evidence. Explicit synthetic declaration supports5/7/13/15, operator accepts13/15, publisher signs13/15; fixed signed coverage13/15 only. SHA1 cause operator-policy; alg17 actual implementation-capability; digest250 separate digest-capability; NSEC3 SHA1 not changed."
  },
