</table></div>
<div class="dtable-wrap dtable-wrap--shade"><table class="sortable dtable dtable--divided dtable--compact" id="table-prime-generator-pairs">
<thead>
<tr>
<th aria-sort="none" class="dtable-sortable" tabindex="0"><span class="dtable-sort-tail">Value<span class="dtable-sort"></span></span></th>
<th aria-sort="none" class="dtable-sortable" tabindex="0"><span class="dtable-sort-tail">Description<span class="dtable-sort"></span></span></th>
