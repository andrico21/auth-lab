            <td class="text-left" rowspan="1" colspan="1">
              <span class="bcp14">MUST</span>
</td>
            <td class="text-left" rowspan="1" colspan="1">
              <span class="bcp14">MUST</span>
</td>
          </tr>
          <tr>
            <td class="text-left" rowspan="1" colspan="1">3</td>
            <td class="text-left" rowspan="1" colspan="1">GOST R 34.11-94</td>
            <td class="text-left" rowspan="1" colspan="1">
              <span class="bcp14">MUST NOT</span>
</td>
