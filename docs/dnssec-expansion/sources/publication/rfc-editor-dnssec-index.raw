86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Use of SHA-256 in DNSSEC Delegation Signer (DS) Resource Records (RRs)</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">W. Hardaker<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->May 2006</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4509" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4509"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4509" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document specifies how to use the SHA-256 digest type in DNS Delegation Signer (DS) Resource Records (RRs).  DS records, when stored in a parent zone, point to DNSKEYs in a child zone. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document specifies how to use the SHA-256 digest type in DNS Delegation Signer (DS) Resource Records (RRs).  DS records, when stored in a parent zone, point to DNSKEYs in a child zone. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-4470-minimally-covering-nsec-records-and-dnssec-on-line-signing" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc4470/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">4470</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Minimally Covering NSEC Records and DNSSEC On-line Signing</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">S. Weiler<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">J. Ihren<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->April 2006</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4470" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4470"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4470" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document describes how to construct DNSSEC NSEC resource records that cover a smaller range of names than called for by RFC 4034.  By generating and signing these records on demand, authoritative name servers can effectively stop the disclosure of zone contents otherwise made possible by walking the chain of NSEC records in a signed zone. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document describes how to construct DNSSEC NSEC resource records that cover a smaller range of names than called for by RFC 4034.  By generating and signing these records on demand, authoritative name servers can effectively stop the disclosure of zone contents otherwise made possible by walking the chain of NSEC records in a signed zone. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-4431-the-dnssec-lookaside-validation-dlv-dns-resource-record" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc4431/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">4431</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> The DNSSEC Lookaside Validation (DLV) DNS Resource Record</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Historic<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">M. Andrews<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">S. Weiler<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->February 2006</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4431" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4431"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4431" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document defines a new DNS resource record, called the DNSSEC Lookaside Validation (DLV) RR, for publishing DNSSEC trust anchors outside of the DNS delegation chain.  This memo provides information for the Internet community.</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document defines a new DNS resource record, called the DNSSEC Lookaside Validation (DLV) RR, for publishing DNSSEC trust anchors outside of the DNS delegation chain.  This memo provides information for the Internet community.</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-4255-using-dns-to-securely-publish-secure-shell-ssh-key-fingerprints" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc4255/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">4255</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Using DNS to Securely Publish Secure Shell (SSH) Key Fingerprints</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">J. Schlyter<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">W. Griffin<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->January 2006</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Security Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4255" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4255"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4255" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document describes a method of verifying Secure Shell (SSH) host keys using Domain Name System Security (DNSSEC).  The document defines a new DNS resource record that contains a standard SSH key fingerprint. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document describes a method of verifying Secure Shell (SSH) host keys using Domain Name System Security (DNSSEC).  The document defines a new DNS resource record that contains a standard SSH key fingerprint. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-pink-50 dark:bg-pink-950 border-pink-400 dark:border-pink-700 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-4310-domain-name-system-dns-security-extensions-mapping-for-the-extensible-provisioning-protocol-epp" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc4310/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">4310</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Domain Name System (DNS) Security Extensions Mapping for the Extensible Provisioning Protocol (EPP)</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">S. Hollenbeck<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->December 2005</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4310" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4310"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4310" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document describes an Extensible Provisioning Protocol (EPP) extension mapping for the provisioning and management of Domain Name System security extensions (DNSSEC) for domain names stored in a shared central repository.  Specified in XML, this mapping extends the EPP domain name mapping to provide additional features required for the provisioning of DNS security extensions. [STANDARDS-TRACK]</p><!--]--></div></div></div><p class="relative z-1 text-red-800 dark:text-red-300 text-base print:text-black"><ul class="inline-block">Obsoleted by <span class="inline-block p-1 -m-1">RFC <b>5910</b></span></ul></p></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document describes an Extensible Provisioning Protocol (EPP) extension mapping for the provisioning and management of Domain Name System security extensions (DNSSEC) for domain names stored in a shared central repository.  Specified in XML, this mapping extends the EPP domain name mapping to provide additional features required for the provisioning of DNS security extensions. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-s