fc3130","rfc3225","rfc3226","rfc3755","rfc3757","rfc3845","rfc4033","rfc4034","rfc4035","rfc4255","rfc4310","rfc4431","rfc4470","rfc4471","rfc4509","rfc4641","rfc4955","rfc4956","rfc4986","rfc5011","rfc5074","rfc5155","rfc5702","rfc5910","rfc5933","rfc6014","rfc6604","rfc6605","rfc6698","rfc6725","rfc6781","rfc6840","rfc6841","rfc6844","rfc6944","rfc6975","rfc7129","rfc7218","rfc7250","rfc7344","rfc7583","rfc7646","rfc7828","rfc7901","rfc7958","rfc8027","rfc8078","rfc8080","rfc8145","rfc8198","rfc8483","rfc8509","rfc8624","rfc8683","rfc8749","rfc8901","rfc8976","rfc9077","rfc9102","rfc9157","rfc9276","rfc9364","rfc9558","rfc9563","rfc9615","rfc9718","rfc9726","rfc9824","rfc9859","rfc9904","rfc9905","rfc9906","rfc9975",{"rfc10026":103,"rfc2065":133,"rfc2137":163,"rfc2535":185,"rfc2536":218,"rfc2537":238,"rfc2538":257,"rfc2539":277,"rfc2540":296,"rfc2541":314,"rfc3007":339,"rfc3008":364,"rfc3090":381,"rfc3130":400,"rfc3225":421,"rfc3226":439,"rfc3755":458,"rfc3757":480,"rfc3845":498,"rfc4033":514,"rfc4034":541,"rfc4035":561,"rfc4255":579,"rfc4310":599,"rfc4431":617,"rfc4470":637,"rfc4471":655,"rfc4509":676,"rfc4641":694,"rfc4955":717,"rfc4956":734,"rfc4986":751,"rfc5011":772,"rfc5074":795,"rfc5155":811,"rfc5702":831,"rfc5910":851,"rfc5933":875,"rfc6014":895,"rfc6604":914,"rfc6605":937,"rfc6698":963,"rfc6725":988,"rfc6781":1004,"rfc6840":1024,"rfc6841":1044,"rfc6844":1066,"rfc6944":1089,"rfc6975":1110,"rfc7129":1127,"rfc7218":1149,"rfc7250":1168,"rfc7344":1192,"rfc7583":1217,"rfc7646":1236,"rfc7828":1261,"rfc7901":1283,"rfc7958":1300,"rfc8027":1320,"rfc8078":1339,"rfc8080":1357,"rfc8145":1380,"rfc8198":1400,"rfc8483":1420,"rfc8509":1442,"rfc8624":1465,"rfc8683":1482,"rfc8749":1508,"rfc8901":1526,"rfc8976":1549,"rfc9077":1570,"rfc9102":1588,"rfc9157":1607,"rfc9276":1623,"rfc9364":1640,"rfc9558":1658,"rfc9563":1674,"rfc9615":1694,"rfc9718":1713,"rfc9726":1729,"rfc9824":1755,"rfc9859":1778,"rfc9904":1798,"rfc9905":1815,"rfc9906":1832,"rfc9975":1848},{"title":104,"subseries":105,"status":107,"status_name":108,"stream":109,"stream_name":109,"obsoletes":110,"obsoleted_by":111,"updates":112,"updated_by":113,"authors":114,"published":117,"identifiers":118,"area":122,"group":125,"keywords":128,"pages":131,"abstract":132},"Operational Recommendations for DNSSEC Delegation Signer (DS) Automation",[106],"bcp246","bcp","best current practice","IETF",[],[],[],[],[115,116],"S. Sheng","P. Thomassen","2026-07-23",[119],{"type":120,"value":121},"doi","10.17487\u002FRFC10026",{"acronym":123,"name":124},"ops","Operations and Management Area",{"acronym":126,"name":127},"dnsop","Domain Name System Operations",[129,130],"DNS","DS",21,"Enabling support for automatic acceptance of DNSSEC Delegation Signer (DS) parameters from the Child DNS operator (via RFCs 7344, 8078, and 9615) requires the Parental Agent, often a registry or registrar, to make a number of technical decisions around acceptance checks, error and success reporting, and multi-party issues such as concurrent updates. This document describes recommendations about how these points are best addressed in practice.",{"title":134,"subseries":135,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":138,"obsoleted_by":139,"updates":141,"updated_by":144,"authors":145,"published":148,"identifiers":149,"area":152,"group":155,"keywords":157,"pages":161,"abstract":162},"Domain Name System Security Extensions",[],"ps","proposed standard",[],[140],2535,[142,143],1034,1035,[],[146,147],"D. Eastlake 3rd","C. Kaufman","1997-01-01",[150],{"type":120,"value":151},"10.17487\u002FRFC2065",{"acronym":153,"name":154},"sec","Security Area",{"acronym":6,"name":156},"Domain Name System Security",[158,129,159,160],"DNS-SEC","authentication","encryption",41,"The Domain Name System (DNS) has become a critical operational part of the Internet infrastructure yet it has no strong security mechanisms to assure data integrity or authentication.  Extensions to the DNS are described that provide these services to security aware resolvers or applications through the use of cryptographic digital signatures. [STANDARDS-TRACK]",{"title":164,"subseries":165,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":166,"obsoleted_by":167,"updates":169,"updated_by":170,"authors":171,"published":172,"identifiers":173,"area":176,"group":177,"keywords":178,"pages":183,"abstract":184},"Secure Domain Name System Dynamic Update",[],[],[168],3007,[143],[],[146],"1997-04-01",[174],{"type":120,"value":175},"10.17487\u002FRFC2137",{"acronym":153,"name":154},{"acronym":6,"name":156},[179,129,180,181,182],"SDNSDU","digital","signatures","cryptographic",11,"This memo describes how to use DNSSEC digital signatures covering requests and data to secure updates and restrict updates to those authorized to perform them as indicated by the updater's possession of cryptographic keys. [STANDARDS-TRACK]",{"title":134,"subseries":186,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":187,"obsoleted_by":189,"updates":193,"updated_by":195,"authors":207,"published":208,"identifiers":209,"area":212,"group":213,"keywords":214,"pages":216,"abstract":217},[],[188],2065,[190,191,192],4033,4034,4035,[142,143,194],2181,[196,168,197,198,199,200,201,202,203,204,205,206],2931,3008,3090,3226,3445,3597,3655,3658,3755,3757,3845,[146],"1999-03-01",[210],{"type":120,"value":211},"10.17487\u002FRFC2535",{"acronym":153,"name":154},{"acronym":6,"name":156},[215,9,159],"DNS-SECEXT",47,"This document incorporates feedback on RFC 2065 from early implementers and potential users. [STANDARDS-TRACK]",{"title":219,"subseries":220,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":221,"obsoleted_by":222,"updates":223,"updated_by":224,"authors":226,"published":208,"identifiers":227,"area":230,"group":231,"keywords":232,"pages":236,"abstract":237},"DSA KEYs and SIGs in the Domain Name System (DNS)",[],[],[],[],[225],6944,[146],[228],{"type":120,"value":229},"10.17487\u002FRFC2536",{"acronym":153,"name":154},{"acronym":6,"name":156},[233,234,181,235],"DSA","digital signature algorithm","cryptology",6,"A standard method for storing US Government Digital Signature Algorithm keys and signatures in the Domain Name System is described which utilizes DNS KEY and SIG resource records. [STANDARDS-TRACK]",{"title":239,"subseries":240,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":241,"obsoleted_by":242,"updates":244,"updated_by":245,"authors":246,"published":208,"identifiers":247,"area":250,"group":251,"keywords":252,"pages":236,"abstract":256},"RSA\u002FMD5 KEYs and SIGs in the Domain Name System (DNS)",[],[],[243],3110,[],[],[146],[248],{"type":120,"value":249},"10.17487\u002FRFC2537",{"acronym":153,"name":154},{"acronym":6,"name":156},[253,254,181,235,255],"message","digest","security","A standard method for storing RSA keys and and RSA\u002FMD5 based signatures in the Domain Name System is described which utilizes DNS KEY and SIG resource records. [STANDARDS-TRACK]",{"title":258,"subseries":259,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":260,"obsoleted_by":261,"updates":263,"updated_by":264,"authors":265,"published":208,"identifiers":267,"area":270,"group":271,"keywords":272,"pages":275,"abstract":276},"Storing Certificates in the Domain Name System (DNS)",[],[],[262],4398,[],[],[146,266],"O. Gudmundsson",[268],{"type":120,"value":269},"10.17487\u002FRFC2538",{"acronym":153,"name":154},{"acronym":6,"name":156},[273,235,274],"SC-DNS","authenticity",10,"Cryptographic public key are frequently published and their authenticity demonstrated by certificates.  A CERT resource record (RR) is defined so that such certificates and related certificate revocation lists can be stored in the Domain Name System (DNS). [STANDARDS-TRACK]",{"title":278,"subseries":279,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":280,"obsoleted_by":281,"updates":282,"updated_by":283,"authors":284,"published":208,"identifiers":285,"area":288,"group":289,"keywords":290,"pages":294,"abstract":295},"Storage of Diffie-Hellman Keys in the Domain Name System (DNS)",[],[],[],[],[225],[146],[286],{"type":120,"value":287},"10.17487\u002FRFC2539",{"acronym":153,"name":154},{"acronym":6,"name":156},[291,292,293,235,159,255,181,180],"DHK-DNS","Diffie-Hellman Keys","Domain Name System",7,"A standard method for storing Diffie-Hellman keys in the Domain Name System is described which utilizes DNS KEY resource records. [STANDARDS-TRACK]",{"title":297,"subseries":298,"status":299,"status_name":300,"stream":109,"stream_name":109,"obsoletes":301,"obsoleted_by":302,"updates":303,"updated_by":304,"authors":305,"published":208,"identifiers":306,"area":309,"group":310,"keywords":311,"pages":236,"abstract":313},"Detached Domain Name System (DNS) Information",[],"exp","experimental",[],[],[],[],[146],[307],{"type":120,"value":308},"10.17487\u002FRFC2540",{"acronym":153,"name":154},{"acronym":6,"name":156},[312,293,255,180,181,159],"DNS-INFO","A standard format is defined for representing detached DNS information.  This is anticipated to be of use for storing information retrieved from the Domain Name System (DNS), including security information, in archival contexts or contexts not connected to the Internet.  This memo defines an Experimental Protocol for the Internet community.",{"title":315,"subseries":316,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":319,"obsoleted_by":320,"updates":322,"updated_by":323,"authors":324,"published":208,"identifiers":325,"area":328,"group":329,"keywords":330,"pages":294,"abstract":338},"DNS Security Operational Considerations",[],"inf","informational",[],[321],4641,[],[],[146],[326],{"type":120,"value":327},"10.17487\u002FRFC2541",{"acronym":153,"name":154},{"acronym":6,"name":156},[331,332,333,334,235,335,336,337],"DNS-SOC","domain","name","system","resource","records","rrs","This document discusses these operational aspects for keys and signatures used in connection with the KEY and SIG DNS resource records.  This memo provides information for the Internet community.",{"title":340,"subseries":341,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":342,"obsoleted_by":344,"updates":345,"updated_by":347,"authors":348,"published":350,"identifiers":351,"area":354,"group":357,"keywords":360,"pages":362,"abstract":363},"Secure Domain Name System (DNS) Dynamic Update",[],[343],2137,[],[346,140],2136,[],[349],"B. Wellington","2000-11-01",[352],{"type":120,"value":353},"10.17487\u002FRFC3007",{"acronym":355,"name":356},"int","Internet Area",{"acronym":358,"name":359},"dnsext","DNS Extensions",[255,159,361,7,293],"validation",9,"This document proposes a method for performing secure Domain Name System (DNS) dynamic updates. [STANDARDS-TRACK]",{"title":365,"subseries":366,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":367,"obsoleted_by":368,"updates":369,"updated_by":370,"authors":371,"published":350,"identifiers":372,"area":375,"group":376,"keywords":377,"pages":294,"abstract":380},"Domain Name System Security (DNSSEC) Signing Authority",[],[],[190,191,192],[140],[203],[349],[373],{"type":120,"value":374},"10.17487\u002FRFC3008",{"acronym":355,"name":356},{"acronym":358,"name":359},[7,159,361,378,379],"SIG","signature","This document proposes a revised model of Domain Name System Security (DNSSEC) Signing Authority.  The revised model is designed to clarify earlier documents and add additional restrictions to simplify the secure resolution process.  Specifically, this affects the authorization of keys to sign sets of records. [STANDARDS-TRACK]",{"title":382,"subseries":383,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":384,"obsoleted_by":385,"updates":386,"updated_by":387,"authors":388,"published":390,"identifiers":391,"area":394,"group":395,"keywords":396,"pages":183,"abstract":399},"DNS Security Extension Clarification on Zone Status",[],[],[190,191,192],[140],[203],[389],"E. Lewis","2001-03-01",[392],{"type":120,"value":393},"10.17487\u002FRFC3090",{"acronym":355,"name":356},{"acronym":358,"name":359},[332,333,334,397,398],"rsa","dsa","The definition of a secured zone is presented, clarifying and updating sections of RFC 2535.  RFC 2535 defines a zone to be secured based on a per algorithm basis, e.g., a zone can be secured with RSA keys, and not secured with DSA keys.  This document changes this to define a zone to be secured or not secured regardless of the key algorithm used (or not used).  To further simplify the determination of a zone's status, \"experimentally secure\" status is deprecated. [STANDARDS-TRACK]",{"title":401,"subseries":402,"status":317,"status_name":318,"stream":403,"stream_name":403,"obsoletes":404,"obsoleted_by":405,"updates":406,"updated_by":407,"authors":408,"published":409,"identifiers":410,"area":413,"group":414,"keywords":417,"pages":275,"abstract":420},"Notes from the State-Of-The-Technology: DNSSEC",[],"Legacy",[],[],[],[],[389],"2001-06-01",[411],{"type":120,"value":412},"10.17487\u002FRFC3130",null,{"acronym":415,"name":416},"none","Individual Submissions",[332,333,334,255,418,419],"extensions","report","This is a memo of a DNSSEC (Domain Name System Security Extensions) status meeting.  This memo provides information for the Internet community.",{"title":422,"subseries":423,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":424,"obsoleted_by":425,"updates":426,"updated_by":427,"authors":428,"published":430,"identifiers":431,"area":434,"group":435,"keywords":436,"pages":236,"abstract":438},"Indicating Resolver Support of DNSSEC",[],[],[],[],[190,191,192],[429],"D. Conrad","2001-12-01",[432],{"type":120,"value":433},"10.17487\u002FRFC3225",{"acronym":355,"name":356},{"acronym":358,"name":359},[7,437],"domain name system security extensions","In order to deploy DNSSEC (Domain Name System Security Extensions) operationally, DNSSEC aware servers should only perform automatic inclusion of DNSSEC RRs when there is an explicit indication that the resolver can understand those RRs.  This document proposes the use of a bit in the EDNS0 header to provide that explicit indication and describes the necessary protocol changes to implement that notification. [STANDARDS-TRACK]",{"title":440,"subseries":441,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":442,"obsoleted_by":443,"updates":444,"updated_by":446,"authors":447,"published":430,"identifiers":448,"area":451,"group":452,"keywords":453,"pages":236,"abstract":457},"DNSSEC and IPv6 A6 aware server\u002Fresolver message size requirements",[],[],[],[140,445],2874,[190,191,192],[266],[449],{"type":120,"value":450},"10.17487\u002FRFC3226",{"acronym":355,"name":356},{"acronym":358,"name":359},[7,437,454,255,418,455,456],"space","EDNS0","Extension Mechanisms for DNSEx","This document mandates support for EDNS0 (Extension Mechanisms for DNS) in DNS entities claiming to support either DNS Security Extensions or A6 records.  This requirement is necessary because these new features increase the size of DNS messages.  If EDNS0 is not supported fall back to TCP will happen, having a detrimental impact on query latency and DNS server load.  This document updates RFC 2535 and RFC 2874, by adding new requirements. [STANDARDS-TRACK]",{"title":459,"subseries":460,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":461,"obsoleted_by":462,"updates":463,"updated_by":464,"authors":465,"published":467,"identifiers":468,"area":471,"group":472,"keywords":473,"pages":362,"abstract":479},"Legacy Resolver Compatibility for Delegation Signer (DS)",[],[],[190,191,192],[140,203],[205,206],[466],"S. Weiler","2004-05-27",[469],{"type":120,"value":470},"10.17487\u002FRFC3755",{"acronym":355,"name":356},{"acronym":358,"name":359},[6,474,475,476,215,9,159,477,478],"DNS Security","rr","resource record","nsec","nextsecure","As the DNS Security (DNSSEC) specifications have evolved, the syntax and semantics of the DNSSEC resource records (RRs) have changed.  Many deployed nameservers understand variants of these semantics.  Dangerous interactions can occur when a resolver that understands an earlier version of these semantics queries an authoritative server that understands the new delegation signer semantics, including at least one failure scenario that will cause an unsecured zone to be unresolvable.  This document changes the type codes and mnemonics of the DNSSEC RRs (SIG, KEY, and NXT) to avoid those interactions. [STANDARDS-TRACK]",{"title":481,"subseries":482,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":483,"obsoleted_by":484,"updates":485,"updated_by":486,"authors":487,"published":467,"identifiers":490,"area":493,"group":494,"keywords":495,"pages":496,"abstract":497},"Domain Name System KEY (DNSKEY) Resource Record (RR) Secure Entry Point (SEP) Flag",[],[],[190,191,192],[140,204],[],[488,489,389],"O. Kolkman","J. Schlyter",[491],{"type":120,"value":492},"10.17487\u002FRFC3757",{"acronym":355,"name":356},{"acronym":358,"name":359},[6],8,"With the Delegation Signer (DS) resource record (RR), the concept of a public key acting as a secure entry point (SEP) has been introduced.  During exchanges of public keys with the parent there is a need to differentiate SEP keys from other public keys in the Domain Name System KEY (DNSKEY) resource record set.  A flag bit in the DNSKEY RR is defined to indicate that DNSKEY is to be used as a SEP.  The flag bit is intended to assist in operational procedures to correctly generate DS resource records, or to indicate what DNSKEYs are intended for static configuration.  The flag bit is not to be used in the DNS verification protocol.  This document updates RFC 2535 and RFC 3755. [STANDARDS-TRACK]",{"title":499,"subseries":500,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":501,"obsoleted_by":502,"updates":503,"updated_by":504,"authors":505,"published":506,"identifiers":507,"area":510,"group":511,"keywords":512,"pages":294,"abstract":513},"DNS Security (DNSSEC) NextSECure (NSEC) RDATA Format",[],[],[190,191,192],[140,204],[],[489],"2004-08-17",[508],{"type":120,"value":509},"10.17487\u002FRFC3845",{"acronym":355,"name":356},{"acronym":358,"name":359},[6,474,475,476,215,9,159,477,478],"This document redefines the wire format of the \"Type Bit Map\" field in the DNS NextSECure (NSEC) resource record RDATA format to cover the full resource record (RR) type space. [STANDARDS-TRACK]",{"title":515,"subseries":516,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":517,"obsoleted_by":518,"updates":519,"updated_by":522,"authors":525,"published":531,"identifiers":532,"area":535,"group":536,"keywords":537,"pages":131,"abstract":540},"DNS Security Introduction and Requirements",[],[140,197,198,200,202,203,204,205,206],[],[142,143,346,194,520,521,199,201],2308,3225,[523,524],6014,6840,[526,527,528,529,530],"R. Arends","R. Austein","M. Larson","D. Massey","S. Rose","2005-03-29",[533],{"type":120,"value":534},"10.17487\u002FRFC4033",{"acronym":355,"name":356},{"acronym":358,"name":359},[538,159,539,6,437],"domain name system","origin integrity","The Domain Name System Security Extensions (DNSSEC) add data origin authentication and data integrity to the Domain Name System.  This document introduces these extensions and describes their capabilities and limitations.  This document also discusses the services that the DNS security extensions do and do not provide.  Last, this document describes the interrelationships between the documents that collectively describe DNSSEC. [STANDARDS-TRACK]",{"title":542,"subseries":543,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":544,"obsoleted_by":545,"updates":546,"updated_by":547,"authors":552,"published":531,"identifiers":553,"area":556,"group":557,"keywords":558,"pages":559,"abstract":560},"Resource Records for the DNS Security Extensions",[],[140,197,198,200,202,203,204,205,206],[],[142,143,346,194,520,521,199,201],[548,523,524,225,549,550,551],4470,9077,9824,9905,[526,527,528,529,530],[554],{"type":120,"value":555},"10.17487\u002FRFC4034",{"acronym":355,"name":356},{"acronym":358,"name":359},[538,159,539,6,437],29,"This document is part of a family of documents that describe the DNS Security Extensions (DNSSEC). The DNS Security Extensions are a collection of resource records and protocol modifications that provide source authentication for the DNS. This document defines the public key (DNSKEY), delegation signer (DS), resource record digital signature (RRSIG), and authenticated denial of existence (NSEC) resource records. The purpose and format of each resource record is described in detail, and an example of each resource record is given.\n\n This document obsoletes RFC 2535 and incorporates changes from all updates to RFC 2535. [STANDARDS-TRACK]",{"title":562,"subseries":563,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":564,"obsoleted_by":565,"updates":566,"updated_by":567,"authors":570,"published":531,"identifiers":571,"area":574,"group":575,"keywords":576,"pages":577,"abstract":578},"Protocol Modifications for the DNS Security Extensions",[],[140,197,198,200,202,203,204,205,206],[],[142,143,346,194,520,521,199,201],[548,523,524,568,549,569,550],8198,9520,[526,527,528,529,530],[572],{"type":120,"value":573},"10.17487\u002FRFC4035",{"acronym":355,"name":356},{"acronym":358,"name":359},[538,159,539,6,437],53,"This document is part of a family of documents that describe the DNS Security Extensions (DNSSEC). The DNS Security Extensions are a collection of new resource records and protocol modifications that add data origin authentication and data integrity to the DNS. This document describes the DNSSEC protocol modifications. This document defines the concept of a signed zone, along with the requirements for serving and resolving by using DNSSEC. These techniques allow a security-aware resolver to authenticate both DNS resource records and authoritative DNS error indications.\n\n This document obsoletes RFC 2535 and incorporates changes from all updates to RFC 2535. [STANDARDS-TRACK]",{"title":580,"subseries":581,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":582,"obsoleted_by":583,"updates":584,"updated_by":585,"authors":586,"published":588,"identifiers":589,"area":592,"group":593,"keywords":596,"pages":362,"abstract":598},"Using DNS to Securely Publish Secure Shell (SSH) Key Fingerprints",[],[],[],[],[],[489,587],"W. Griffin","2006-01-06",[590],{"type":120,"value":591},"10.17487\u002FRFC4255",{"acronym":153,"name":154},{"acronym":594,"name":595},"secsh","Secure Shell",[538,6,597],"domain name system security","This document describes a method of verifying Secure Shell (SSH) host keys using Domain Name System Security (DNSSEC).  The document defines a new DNS resource record that contains a standard SSH key fingerprint. [STANDARDS-TRACK]",{"title":600,"subseries":601,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":602,"obsoleted_by":603,"updates":605,"updated_by":606,"authors":607,"published":609,"identifiers":610,"area":413,"group":613,"keywords":614,"pages":615,"abstract":616},"Domain Name System (DNS) Security Extensions Mapping for the Extensible Provisioning Protocol (EPP)",[],[],[604],5910,[],[],[608],"S. Hollenbeck","2005-12-05",[611],{"type":120,"value":612},"10.17487\u002FRFC4310",{"acronym":123,"name":124},[6,437],22,"This document describes an Extensible Provisioning Protocol (EPP) extension mapping for the provisioning and management of Domain Name System security extensions (DNSSEC) for domain names stored in a shared central repository.  Specified in XML, this mapping extends the EPP domain name mapping to provide additional features required for the provisioning of DNS security extensions. [STANDARDS-TRACK]",{"title":618,"subseries":619,"status":620,"status_name":621,"stream":109,"stream_name":109,"obsoletes":622,"obsoleted_by":623,"updates":624,"updated_by":625,"authors":626,"published":628,"identifiers":629,"area":413,"group":632,"keywords":633,"pages":635,"abstract":636},"The DNSSEC Lookaside Validation (DLV) DNS Resource Record",[],"hist","historic",[],[],[],[],[627,466],"M. Andrews","2006-02-27",[630],{"type":120,"value":631},"10.17487\u002FRFC4431",{"acronym":355,"name":356},[9,634],"domain name space",4,"This document defines a new DNS resource record, called the DNSSEC Lookaside Validation (DLV) RR, for publishing DNSSEC trust anchors outside of the DNS delegation chain.  This memo provides information for the Internet community.",{"title":638,"subseries":639,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":640,"obsoleted_by":641,"updates":642,"updated_by":643,"authors":644,"published":646,"identifiers":647,"area":650,"group":651,"keywords":652,"pages":496,"abstract":654},"Minimally Covering NSEC Records and DNSSEC On-line Signing",[],[],[],[191,192],[],[466,645],"J. Ihren","2006-04-28",[648],{"type":120,"value":649},"10.17487\u002FRFC4470",{"acronym":355,"name":356},{"acronym":358,"name":359},[653,538],"dns security","This document describes how to construct DNSSEC NSEC resource records that cover a smaller range of names than called for by RFC 4034.  By generating and signing these records on demand, authoritative name servers can effectively stop the disclosure of zone contents otherwise made possible by walking the chain of NSEC records in a signed zone. [STANDARDS-TRACK]",{"title":656,"subseries":657,"status":299,"status_name":300,"stream":109,"stream_name":109,"obsoletes":658,"obsoleted_by":659,"updates":660,"updated_by":661,"authors":662,"published":665,"identifiers":666,"area":669,"group":670,"keywords":671,"pages":674,"abstract":675},"Derivation of DNS Name Predecessor and Successor",[],[],[],[],[],[663,664],"G. Sisson","B. Laurie","2006-09-20",[667],{"type":120,"value":668},"10.17487\u002FRFC4471",{"acronym":355,"name":356},{"acronym":358,"name":359},[672,673,6],"domain namespace","dynamic nsec",23,"This document describes two methods for deriving the canonically-ordered predecessor and successor of a DNS name.  These methods may be used for dynamic NSEC resource record synthesis, enabling security-aware name servers to provide authenticated denial of existence without disclosing other owner names in a DNSSEC secured zone.  This memo defines an Experimental Protocol for the Internet community.",{"title":677,"subseries":678,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":679,"obsoleted_by":680,"updates":681,"updated_by":682,"authors":683,"published":685,"identifiers":686,"area":689,"group":690,"keywords":691,"pages":294,"abstract":693},"Use of SHA-256 in DNSSEC Delegation Signer (DS) Resource Records (RRs)",[],[],[],[],[],[684],"W. Hardaker","2006-05-12",[687],{"type":120,"value":688},"10.17487\u002FRFC4509",{"acronym":355,"name":356},{"acronym":358,"name":359},[538,9,692],"dnskey","This document specifies how to use the SHA-256 digest type in DNS Delegation Signer (DS) Resource Records (RRs).  DS records, when stored in a parent zone, point to DNSKEYs in a child zone. [STANDARDS-TRACK]",{"title":695,"subseries":696,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":697,"obsoleted_by":699,"updates":701,"updated_by":702,"authors":703,"published":705,"identifiers":706,"area":709,"group":710,"keywords":711,"pages":715,"abstract":716},"DNSSEC Operational Practices",[],[698],2541,[700],6781,[],[],[488,704],"R. Gieben","2006-09-14",[707],{"type":120,"value":708},"10.17487\u002FRFC4641",{"acronym":123,"name":124},{"acronym":126,"name":127},[9,634,712,713,331,235,714,337],"security extensions","zone administrator","resource records",35,"This document describes a set of practices for operating the DNS with security extensions (DNSSEC). The target audience is zone administrators deploying DNSSEC.\n\n The document discusses operational aspects of using keys and signatures in the DNS. It discusses issues of key generation, key storage, signature generation, key rollover, and related policies.\n\n This document obsoletes RFC 2541, as it covers more operational ground and gives more up-to-date requirements with respect to key sizes and the new DNSSEC specification. This memo provides information for the Internet community.",{"title":718,"subseries":719,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":720,"obsoleted_by":721,"updates":722,"updated_by":723,"authors":724,"published":726,"identifiers":727,"area":730,"group":731,"keywords":732,"pages":294,"abstract":733},"DNS Security (DNSSEC) Experiments",[],[],[],[],[],[725],"D. Blacka","2007-07-27",[728],{"type":120,"value":729},"10.17487\u002FRFC4955",{"acronym":355,"name":356},{"acronym":358,"name":359},[672],"This document describes a methodology for deploying alternate, non-backwards-compatible, DNS Security (DNSSEC) methodologies in an experimental fashion without disrupting the deployment of standard DNSSEC. [STANDARDS-TRACK]",{"title":735,"subseries":736,"status":299,"status_name":300,"stream":109,"stream_name":109,"obsoletes":737,"obsoleted_by":738,"updates":739,"updated_by":740,"authors":741,"published":726,"identifiers":743,"area":746,"group":747,"keywords":748,"pages":749,"abstract":750},"DNS Security (DNSSEC) Opt-In",[],[],[],[],[],[526,742,725],"M. Kosters",[744],{"type":120,"value":745},"10.17487\u002FRFC4956",{"acronym":355,"name":356},{"acronym":358,"name":359},[672],17,"In the DNS security (DNSSEC) extensions, delegations to unsigned subzones are cryptographically secured.  Maintaining this cryptography is not always practical or necessary.  This document describes an experimental \"Opt-In\" model that allows administrators to omit this cryptography and manage the cost of adopting DNSSEC with large zones.  This memo defines an Experimental Protocol for the Internet community.",{"title":752,"subseries":753,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":754,"obsoleted_by":755,"updates":756,"updated_by":757,"authors":758,"published":763,"identifiers":764,"area":767,"group":768,"keywords":769,"pages":183,"abstract":771},"Requirements Related to DNS Security (DNSSEC) Trust Anchor Rollover",[],[],[],[],[],[759,760,761,762],"H. Eland","R. Mundy","S. Crocker","S. Krishnaswamy","2007-08-29",[765],{"type":120,"value":766},"10.17487\u002FRFC4986",{"acronym":355,"name":356},{"acronym":358,"name":359},[770],"dns signed zone","Every DNS security-aware resolver must have at least one Trust Anchor to use as the basis for validating responses from DNS signed zones.  For various reasons, most DNS security-aware resolvers are expected to have several Trust Anchors.  For some operations, manual monitoring and updating of Trust Anchors may be feasible, but many operations will require automated methods for updating Trust Anchors in their security-aware resolvers.  This document identifies the requirements that must be met by an automated DNS Trust Anchor rollover solution for security-aware DNS resolvers.  This memo provides information for the Internet community.",{"title":773,"subseries":774,"status":776,"status_name":777,"stream":109,"stream_name":109,"obsoletes":778,"obsoleted_by":779,"updates":780,"updated_by":781,"authors":782,"published":784,"identifiers":785,"area":788,"group":789,"keywords":790,"pages":793,"abstract":794},"Automated Updates of DNS Security (DNSSEC) Trust Anchors",[775],"std74","std","internet standard",[],[],[],[],[783],"M. StJohns","2007-09-06",[786],{"type":120,"value":787},"10.17487\u002FRFC5011",{"acronym":355,"name":356},{"acronym":358,"name":359},[791,792],"n-1 key","n keys",14,"This document describes a means for automated, authenticated, and authorized updating of DNSSEC \"trust anchors\". The method provides protection against N-1 key compromises of N keys in the trust point key set. Based on the trust established by the presence of a current anchor, other anchors may be added at the same place in the hierarchy, and, ultimately, supplant the existing anchor(s).\n\n This mechanism will require changes to resolver management behavior (but not resolver resolution behavior), and the addition of a single flag bit to the DNSKEY record. [STANDARDS-TRACK]",{"title":796,"subseries":797,"status":620,"status_name":621,"stream":109,"stream_name":109,"obsoletes":798,"obsoleted_by":799,"updates":800,"updated_by":801,"authors":802,"published":803,"identifiers":804,"area":413,"group":807,"keywords":808,"pages":183,"abstract":810},"DNSSEC Lookaside Validation (DLV)",[],[],[],[],[],[466],"2007-11-13",[805],{"type":120,"value":806},"10.17487\u002FRFC5074",{"acronym":153,"name":154},[653,809],"trust anchors","DNSSEC Lookaside Validation (DLV) is a mechanism for publishing DNS Security (DNSSEC) trust anchors outside of the DNS delegation chain.  It allows validating resolvers to validate DNSSEC-signed data from zones whose ancestors either aren't signed or don't publish Delegation Signer (DS) records for their children.  This memo provides information for the Internet community.",{"title":812,"subseries":813,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":814,"obsoleted_by":815,"updates":816,"updated_by":817,"authors":820,"published":821,"identifiers":822,"area":825,"group":826,"keywords":827,"pages":829,"abstract":830},"DNS Security (DNSSEC) Hashed Authenticated Denial of Existence",[],[],[],[],[524,225,549,818,819,551],9157,9276,[664,663,526,725],"2008-03-06",[823],{"type":120,"value":824},"10.17487\u002FRFC5155",{"acronym":355,"name":356},{"acronym":358,"name":359},[538,477,476,828],"nsec3",52,"The Domain Name System Security (DNSSEC) Extensions introduced the NSEC resource record (RR) for authenticated denial of existence.  This document introduces an alternative resource record, NSEC3, which similarly provides authenticated denial of existence.  However, it also provides measures against zone enumeration and permits gradual expansion of delegation-centric zones. [STANDARDS-TRACK]",{"title":832,"subseries":833,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":834,"obsoleted_by":835,"updates":836,"updated_by":837,"authors":838,"published":840,"identifiers":841,"area":844,"group":845,"keywords":846,"pages":275,"abstract":850},"Use of SHA-2 Algorithms with RSA in DNSKEY and RRSIG Resource Records for DNSSEC",[],[],[],[],[225],[839],"J. Jansen","2009-10-28",[842],{"type":120,"value":843},"10.17487\u002FRFC5702",{"acronym":355,"name":356},{"acronym":358,"name":359},[7,847,848,849],"RSA","SHA-256","SHA-512","This document describes how to produce RSA\u002FSHA-256 and RSA\u002FSHA-512 DNSKEY and RRSIG resource records for use in the Domain Name System Security Extensions (RFC 4033, RFC 4034, and RFC 4035). [STANDARDS TRACK]",{"title":600,"subseries":852,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":853,"obsoleted_by":855,"updates":856,"updated_by":857,"authors":858,"published":860,"identifiers":861,"area":413,"group":864,"keywords":867,"pages":873,"abstract":874},[],[854],4310,[],[],[],[859,608],"J. Gould","2010-05-11",[862],{"type":120,"value":863},"10.17487\u002FRFC5910",{"acronym":865,"name":866},"app","Applications Area",[868,869,870,9,255,6,871,872],"epp","Extensible Provisioning Protocol","xml","delegation signer","ds",36,"This document describes an Extensible Provisioning Protocol (EPP) extension mapping for the provisioning and management of Domain Name System security (DNSSEC) extensions for domain names stored in a shared central repository.  Specified in XML, this mapping extends the EPP domain name mapping to provide additional features required for the provisioning of DNS security extensions.  This document obsoletes RFC 4310. [STANDARDS-TRACK]",{"title":876,"subseries":877,"status":620,"status_name":621,"stream":109,"stream_name":109,"obsoletes":878,"obsoleted_by":879,"updates":880,"updated_by":881,"authors":882,"published":886,"identifiers":887,"area":890,"group":891,"keywords":892,"pages":362,"abstract":894},"Use of GOST Signature Algorithms in DNSKEY and RRSIG Resource Records for DNSSEC",[],[],[],[],[225],[883,884,885],"V. Dolmatov","A. Chuprina","I. Ustinov","2010-07-09",[888],{"type":120,"value":889},"10.17487\u002FRFC5933",{"acronym":355,"name":356},{"acronym":358,"name":359},[437,893],"ECC","This document describes how to produce digital signatures and hash functions using the GOST R 34.10-2001 and GOST R 34.11-94 algorithms for DNSKEY, RRSIG, and DS resource records, for use in the Domain Name System Security Extensions (DNSSEC).",{"title":896,"subseries":897,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":898,"obsoleted_by":899,"updates":900,"updated_by":901,"authors":902,"published":904,"identifiers":905,"area":908,"group":909,"keywords":910,"pages":236,"abstract":913},"Cryptographic Algorithm Identifier Allocation for DNSSEC",[],[],[],[190,191,192],[818],[903],"P. Hoffman","2010-11-22",[906],{"type":120,"value":907},"10.17487\u002FRFC6014",{"acronym":355,"name":356},{"acronym":358,"name":359},[7,911,912],"digital signatures","algorithms","This document specifies how DNSSEC cryptographic algorithm identifiers in the IANA registries are allocated.  It changes the requirement from \"standard required\" to \"RFC Required\".  It does not change the list of algorithms that are recommended or required for DNSSEC implementations. [STANDARDS-TRACK]",{"title":915,"subseries":916,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":917,"obsoleted_by":918,"updates":919,"updated_by":921,"authors":922,"published":923,"identifiers":924,"area":927,"group":928,"keywords":929,"pages":935,"abstract":936},"xNAME RCODE and Status Bits Clarification",[],[],[],[143,520,920],2672,[],[146],"2012-04-14",[925],{"type":120,"value":926},"10.17487\u002FRFC6604",{"acronym":355,"name":356},{"acronym":358,"name":359},[129,7,930,931,932,933,934],"CNAME","DNAME","Domain Name","response code","canonical name",5,"The Domain Name System (DNS) has long provided means, such as the CNAME (Canonical Name), whereby a DNS query can be redirected to a different name.  A DNS response header has an RCODE (Response Code) field, used for indicating errors, and response status bits.  This document clarifies, in the case of such redirected queries, how the RCODE and status bits correspond to the initial query cycle (where the CNAME or the like was detected) and subsequent or final query cycles. [STANDARDS-TRACK]",{"title":938,"subseries":939,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":940,"obsoleted_by":941,"updates":942,"updated_by":943,"authors":944,"published":946,"identifiers":947,"area":950,"group":951,"keywords":952,"pages":496,"abstract":962},"Elliptic Curve Digital Signature Algorithm (DSA) for DNSSEC",[],[],[],[],[],[903,945],"W.C.A. Wijngaards","2012-04-13",[948],{"type":120,"value":949},"10.17487\u002FRFC6605",{"acronym":355,"name":356},{"acronym":358,"name":359},[953,954,955,956,957,130,958,959,960,961],"dnskey algorithm","ds hash algo","crypto","DNS key","DNSKEY algorithm","digest hash cryptography","SHA-384","ECDSAP256SHA256","ECDSAP384SHA384","This document describes how to specify Elliptic Curve Digital Signature Algorithm (DSA) keys and signatures in DNS Security (DNSSEC).  It lists curves of different sizes and uses the SHA-2 family of hashes for signatures. [STANDARDS-TRACK]",{"title":964,"subseries":965,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":966,"obsoleted_by":967,"updates":968,"updated_by":969,"authors":973,"published":974,"identifiers":975,"area":978,"group":979,"keywords":982,"pages":986,"abstract":987},"The DNS-Based Authentication of Named Entities (DANE) Transport Layer Security (TLS) Protocol: TLSA",[],[],[],[],[970,971,972],7218,7671,8749,[903,489],"2012-08-07",[976],{"type":120,"value":977},"10.17487\u002FRFC6698",{"acronym":153,"name":154},{"acronym":980,"name":981},"dane","DNS-based Authentication of Named Entities",[7,983,984,985],"certificates","public keys","PKI",37,"Encrypted communication on the Internet often uses Transport Layer Security (TLS), which depends on third parties to certify the keys used.  This document improves on that situation by enabling the administrators of domain names to specify the keys used in that domain's TLS servers.  This requires matching improvements in TLS client software, but no change in TLS server software. [STANDARDS-TRACK]",{"title":989,"subseries":990,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":991,"obsoleted_by":992,"updates":993,"updated_by":994,"authors":995,"published":996,"identifiers":997,"area":1000,"group":1001,"keywords":1002,"pages":935,"abstract":1003},"DNS Security (DNSSEC) DNSKEY Algorithm IANA Registry Updates",[],[],[],[],[],[530],"2012-08-30",[998],{"type":120,"value":999},"10.17487\u002FRFC6725",{"acronym":355,"name":356},{"acronym":358,"name":359},[],"The DNS Security Extensions (DNSSEC) require the use of cryptographic algorithm suites for generating digital signatures over DNS data.  The algorithms specified for use with DNSSEC are reflected in an IANA-maintained registry.  This document presents a set of changes for some entries of the registry. [STANDARDS-TRACK]",{"title":1005,"subseries":1006,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1007,"obsoleted_by":1008,"updates":1009,"updated_by":1010,"authors":1011,"published":1013,"identifiers":1014,"area":1017,"group":1018,"keywords":1019,"pages":1022,"abstract":1023},"DNSSEC Operational Practices, Version 2",[],[321],[],[],[],[488,1012,704],"W. Mekking","2012-12-22",[1015],{"type":120,"value":1016},"10.17487\u002FRFC6781",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1020,1021],"operational","key rollover",71,"This document describes a set of practices for operating the DNS with security extensions (DNSSEC). The target audience is zone administrators deploying DNSSEC.\n\n The document discusses operational aspects of using keys and signatures in the DNS. It discusses issues of key generation, key storage, signature generation, key rollover, and related policies.\n\n This document obsoletes RFC 4641, as it covers more operational ground and gives more up-to-date requirements with respect to key sizes and the DNSSEC operations.",{"title":1025,"subseries":1026,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1027,"obsoleted_by":1028,"updates":1029,"updated_by":1031,"authors":1032,"published":1033,"identifiers":1034,"area":1037,"group":1038,"keywords":1039,"pages":131,"abstract":1043},"Clarifications and Implementation Notes for DNS Security (DNSSEC)",[],[],[],[190,191,192,1030],5155,[972],[466,725],"2013-02-21",[1035],{"type":120,"value":1036},"10.17487\u002FRFC6840",{"acronym":355,"name":356},{"acronym":358,"name":359},[1040,1041,1042],"EAP","AAA","reconnect","This document is a collection of technical clarifications to the DNS Security (DNSSEC) document set. It is meant to serve as a resource to implementors as well as a collection of DNSSEC errata that existed at the time of writing.\n\n This document updates the core DNSSEC documents (RFC 4033, RFC 4034, and RFC 4035) as well as the NSEC3 specification (RFC 5155). It also defines NSEC3 and SHA-2 (RFC 4509 and RFC 5702) as core parts of the DNSSEC specification.",{"title":1045,"subseries":1046,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1047,"obsoleted_by":1048,"updates":1049,"updated_by":1050,"authors":1051,"published":1055,"identifiers":1056,"area":1059,"group":1060,"keywords":1061,"pages":1064,"abstract":1065},"A Framework for DNSSEC Policies and DNSSEC Practice Statements",[],[],[],[],[],[1052,1053,1054],"F. Ljunggren","AM. Eklund Lowinder","T. Okubo","2013-01-11",[1057],{"type":120,"value":1058},"10.17487\u002FRFC6841",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1062,1063],"DP","DPS",27,"This document presents a framework to assist writers of DNS Security Extensions (DNSSEC) Policies and DNSSEC Practice Statements, such as domain managers and zone operators on both the top level and secondary level, who are managing and operating a DNS zone with Security Extensions implemented.\n\n In particular, the framework provides a comprehensive list of topics that should be considered for inclusion into a DNSSEC Policy definition and Practice Statement. This document is not an Internet Standards Track specification; it is published for informational purposes.",{"title":1067,"subseries":1068,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1069,"obsoleted_by":1070,"updates":1072,"updated_by":1073,"authors":1074,"published":1077,"identifiers":1078,"area":1081,"group":1082,"keywords":1085,"pages":1087,"abstract":1088},"DNS Certification Authority Authorization (CAA) Resource Record",[],[],[1071],8659,[],[],[1075,1076],"P. Hallam-Baker","R. Stradling","2013-01-26",[1079],{"type":120,"value":1080},"10.17487\u002FRFC6844",{"acronym":153,"name":154},{"acronym":1083,"name":1084},"pkix","Public-Key Infrastructure (X.509)",[129,7,1086],"PKIX",18,"The Certification Authority Authorization (CAA) DNS Resource Record allows a DNS domain name holder to specify one or more Certification Authorities (CAs) authorized to issue certificates for that domain.  CAA Resource Records allow a public Certification Authority to implement additional controls to reduce the risk of unintended certificate mis-issue.  This document defines the syntax of the CAA record and rules for processing CAA records by certificate issuers. [STANDARDS-TRACK]",{"title":1090,"subseries":1091,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1092,"obsoleted_by":1093,"updates":1095,"updated_by":1100,"authors":1101,"published":1102,"identifiers":1103,"area":1106,"group":1107,"keywords":1108,"pages":294,"abstract":1109},"Applicability Statement: DNS Security (DNSSEC) DNSKEY Algorithm Implementation Status",[],[],[1094],8624,[1096,1097,243,191,262,1030,1098,1099],2536,2539,5702,5933,[],[530],"2013-04-30",[1104],{"type":120,"value":1105},"10.17487\u002FRFC6944",{"acronym":355,"name":356},{"acronym":358,"name":359},[],"The DNS Security Extensions (DNSSEC) requires the use of cryptographic algorithm suites for generating digital signatures over DNS data.  There is currently an IANA registry for these algorithms, but there is no record of the recommended implementation status of each algorithm.  This document provides an applicability statement on algorithm implementation status for DNSSEC component software.  This document lists each algorithm's status based on the current reference.  In the case that an algorithm is specified without an implementation status, this document assigns one.  This document updates RFCs 2536, 2539, 3110, 4034, 4398, 5155, 5702, and 5933.",{"title":1111,"subseries":1112,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1113,"obsoleted_by":1114,"updates":1115,"updated_by":1116,"authors":1117,"published":1118,"identifiers":1119,"area":1122,"group":1123,"keywords":1124,"pages":362,"abstract":1126},"Signaling Cryptographic Algorithm Understanding in DNS Security Extensions (DNSSEC)",[],[],[],[],[],[761,530],"2013-07-03",[1120],{"type":120,"value":1121},"10.17487\u002FRFC6975",{"acronym":355,"name":356},{"acronym":358,"name":359},[129,7,1125],"EDNS","The DNS Security Extensions (DNSSEC) were developed to provide origin authentication and integrity protection for DNS data by using digital signatures.  These digital signatures can be generated using different algorithms.  This document specifies a way for validating end-system resolvers to signal to a server which digital signature and hash algorithms they support.  The extensions allow the signaling of new algorithm uptake in client code to allow zone administrators to know when it is possible to complete an algorithm rollover in a DNSSEC-signed zone.",{"title":1128,"subseries":1129,"status":317,"status_name":318,"stream":1130,"stream_name":1131,"obsoletes":1132,"obsoleted_by":1133,"updates":1134,"updated_by":1135,"authors":1136,"published":1137,"identifiers":1138,"area":413,"group":1141,"keywords":1142,"pages":1147,"abstract":1148},"Authenticated Denial of Existence in the DNS",[],"INDEPENDENT","Independent Stream",[],[],[],[],[704,1012],"2014-02-12",[1139],{"type":120,"value":1140},"10.17487\u002FRFC7129",{"acronym":415,"name":416},[1143,7,1144,1145,1146],"Internet","Denial of Existence","NSEC","NSEC3",30,"Authenticated denial of existence allows a resolver to validate that a certain domain name does not exist. It is also used to signal that a domain name exists but does not have the specific resource record (RR) type you were asking for. When returning a negative DNS Security Extensions (DNSSEC) response, a name server usually includes up to two NSEC records. With NSEC version 3 (NSEC3), this amount is three.\n\n This document provides additional background commentary and some context for the NSEC and NSEC3 mechanisms used by DNSSEC to provide authenticated denial-of-existence responses.",{"title":1150,"subseries":1151,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1152,"obsoleted_by":1153,"updates":1154,"updated_by":1156,"authors":1157,"published":1158,"identifiers":1159,"area":1162,"group":1163,"keywords":1164,"pages":935,"abstract":1167},"Adding Acronyms to Simplify Conversations about DNS-Based Authentication of Named Entities (DANE)",[],[],[],[1155],6698,[],[266],"2014-04-22",[1160],{"type":120,"value":1161},"10.17487\u002FRFC7218",{"acronym":153,"name":154},{"acronym":980,"name":981},[7,1165,1166],"DANE","Applications","Experience has shown that people get confused when discussing the three numeric fields of the TLSA record.  This document specifies descriptive acronyms for the three numeric fields in TLSA records.  This document updates the format of the IANA registry created by RFC 6698.",{"title":1169,"subseries":1170,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1171,"obsoleted_by":1172,"updates":1173,"updated_by":1174,"authors":1175,"published":1180,"identifiers":1181,"area":1184,"group":1185,"keywords":1188,"pages":1087,"abstract":1191},"Using Raw Public Keys in Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS)",[],[],[],[],[],[1176,1177,1178,466,1179],"P. Wouters","H. Tschofenig","J. Gilmore","T. Kivinen","2014-06-26",[1182],{"type":120,"value":1183},"10.17487\u002FRFC7250",{"acronym":153,"name":154},{"acronym":1186,"name":1187},"tls","Transport Layer Security",[1189,7,1165,1190],"TLS","Raw Public Key","This document specifies a new certificate type and two TLS extensions for exchanging raw public keys in Transport Layer Security (TLS) and Datagram Transport Layer Security (DTLS).  The new certificate type allows raw public keys to be used for authentication.",{"title":1193,"subseries":1194,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1195,"obsoleted_by":1196,"updates":1197,"updated_by":1198,"authors":1202,"published":1205,"identifiers":1206,"area":1209,"group":1210,"keywords":1211,"pages":1087,"abstract":1216},"Automating DNSSEC Delegation Trust Maintenance",[],[],[],[],[1199,1200,1201],8078,9615,9975,[1203,266,1204],"W. Kumari","G. Barwood","2014-09-02",[1207],{"type":120,"value":1208},"10.17487\u002FRFC7344",{"acronym":123,"name":124},{"acronym":126,"name":127},[1212,1213,1214,1215,7,129],"key roll","trust anchor","CDS","CDNSKEY","This document describes a method to allow DNS Operators to more\r\neasily update DNSSEC Key Signing Keys using the DNS as a\r\ncommunication channel.  The technique described is aimed at\r\ndelegations in which it is currently hard to move information from\r\nthe Child to Parent.",{"title":1218,"subseries":1219,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1220,"obsoleted_by":1221,"updates":1222,"updated_by":1223,"authors":1224,"published":1227,"identifiers":1228,"area":1231,"group":1232,"keywords":1233,"pages":1234,"abstract":1235},"DNSSEC Key Rollover Timing Considerations",[],[],[],[],[],[1225,645,1226,1012],"S. Morris","J. Dickinson","2015-10-21",[1229],{"type":120,"value":1230},"10.17487\u002FRFC7583",{"acronym":123,"name":124},{"acronym":126,"name":127},[],31,"This document describes the issues surrounding the timing of events in the rolling of a key in a DNSSEC-secured zone.  It presents timelines for the key rollover and explicitly identifies the relationships between the various parameters affecting the process.",{"title":1237,"subseries":1238,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1239,"obsoleted_by":1240,"updates":1241,"updated_by":1242,"authors":1243,"published":1248,"identifiers":1249,"area":1252,"group":1253,"keywords":1254,"pages":1259,"abstract":1260},"Definition and Use of DNSSEC Negative Trust Anchors",[],[],[],[],[],[1244,1203,1245,1246,1247],"P. Ebersman","C. Griffiths","J. Livingood","R. Weber","2015-09-23",[1250],{"type":120,"value":1251},"10.17487\u002FRFC7646",{"acronym":123,"name":124},{"acronym":126,"name":127},[1255,1256,1257,129,7,1258],"NTA","ISP","Internet Service Provider","Negative Trust Anchors",16,"DNS Security Extensions (DNSSEC) is now entering widespread deployment.  However, domain signing tools and processes are not yet as mature and reliable as those for non-DNSSEC-related domain administration tools and processes.  This document defines Negative Trust Anchors (NTAs), which can be used to mitigate DNSSEC validation failures by disabling DNSSEC validation at specified domains.",{"title":1262,"subseries":1263,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1264,"obsoleted_by":1265,"updates":1266,"updated_by":1267,"authors":1268,"published":1272,"identifiers":1273,"area":1276,"group":1277,"keywords":1278,"pages":183,"abstract":1282},"The edns-tcp-keepalive EDNS0 Option",[],[],[],[],[],[1176,1269,1270,1271],"J. Abley","S. Dickinson","R. Bellis","2016-04-06",[1274],{"type":120,"value":1275},"10.17487\u002FRFC7828",{"acronym":123,"name":124},{"acronym":126,"name":127},[1279,6,129,1280,1281],"long-lived","TCP\u002FIP","transport","DNS messages between clients and servers may be received over either UDP or TCP. UDP transport involves keeping less state on a busy server, but can cause truncation and retries over TCP. Additionally, UDP can be exploited for reflection attacks. Using TCP would reduce retransmits and amplification. However, clients commonly use TCP only for retries and servers typically use idle timeouts on the order of seconds.\n\n This document defines an EDNS0 option (\"edns-tcp-keepalive\") that allows DNS servers to signal a variable idle timeout. This signalling encourages the use of long-lived TCP connections by allowing the state associated with TCP transport to be managed effectively with minimal impact on the DNS transaction time.",{"title":1284,"subseries":1285,"status":299,"status_name":300,"stream":109,"stream_name":109,"obsoletes":1286,"obsoleted_by":1287,"updates":1288,"updated_by":1289,"authors":1290,"published":1291,"identifiers":1292,"area":1295,"group":1296,"keywords":1297,"pages":1259,"abstract":1299},"CHAIN Query Requests in DNS",[],[],[],[],[],[1176],"2016-06-21",[1293],{"type":120,"value":1294},"10.17487\u002FRFC7901",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,455,1298],"latency","This document defines an EDNS0 extension that can be used by a security-aware validating resolver configured to use a forwarding resolver to send a single query, requesting a complete validation path along with the regular query answer.  The reduction in queries potentially lowers the latency and reduces the need to send multiple queries at once.  This extension mandates the use of source-IP- verified transport such as TCP or UDP with EDNS-COOKIE, so it cannot be abused in amplification attacks.",{"title":1301,"subseries":1302,"status":317,"status_name":318,"stream":1130,"stream_name":1131,"obsoletes":1303,"obsoleted_by":1304,"updates":1306,"updated_by":1307,"authors":1308,"published":1310,"identifiers":1311,"area":413,"group":1314,"keywords":1315,"pages":793,"abstract":1319},"DNSSEC Trust Anchor Publication for the Root Zone",[],[],[1305],9718,[],[],[1269,489,1309,903],"G. Bailey","2016-08-31",[1312],{"type":120,"value":1313},"10.17487\u002FRFC7958",{"acronym":415,"name":416},[129,1316,1317,1318],"ICANN","IANA","KSK","The root zone of the Domain Name System (DNS) has been cryptographically signed using DNS Security Extensions (DNSSEC).\n\n In order to obtain secure answers from the root zone of the DNS using DNSSEC, a client must configure a suitable trust anchor. This document describes the format and publication mechanisms IANA has used to distribute the DNSSEC trust anchors.",{"title":1321,"subseries":1322,"status":107,"status_name":108,"stream":109,"stream_name":109,"obsoletes":1324,"obsoleted_by":1325,"updates":1326,"updated_by":1327,"authors":1328,"published":1329,"identifiers":1330,"area":1333,"group":1334,"keywords":1335,"pages":1337,"abstract":1338},"DNSSEC Roadblock Avoidance",[1323],"bcp207",[],[],[],[],[684,266,762],"2016-11-28",[1331],{"type":120,"value":1332},"10.17487\u002FRFC8027",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1336,129],"Network Problems",19,"This document describes problems that a Validating DNS resolver, stub-resolver, or application might run into within a non-compliant infrastructure.  It outlines potential detection and mitigation techniques.  The scope of the document is to create a shared approach to detect and overcome network issues that a DNSSEC software\u002Fsystem may face.",{"title":1340,"subseries":1341,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1342,"obsoleted_by":1343,"updates":1344,"updated_by":1346,"authors":1347,"published":1348,"identifiers":1349,"area":1352,"group":1353,"keywords":1354,"pages":275,"abstract":1356},"Managing DS Records from the Parent via CDS\u002FCDNSKEY",[],[],[],[1345],7344,[1200],[266,1176],"2017-03-10",[1350],{"type":120,"value":1351},"10.17487\u002FRFC8078",{"acronym":123,"name":124},{"acronym":126,"name":127},[6,1355],"trust maintenance","RFC 7344 specifies how DNS trust can be maintained across key rollovers in-band between parent and child. This document elevates RFC 7344 from Informational to Standards Track. It also adds a method for initial trust setup and removal of a secure entry point.\n\n Changing a domain's DNSSEC status can be a complicated matter involving multiple unrelated parties. Some of these parties, such as the DNS operator, might not even be known by all the organizations involved. The inability to disable DNSSEC via in-band signaling is seen as a problem or liability that prevents some DNSSEC adoption at a large scale. This document adds a method for in-band signaling of these DNSSEC status changes.\n\n This document describes reasonable policies to ease deployment of the initial acceptance of new secure entry points (DS records).\n\n It is preferable that operators collaborate on the transfer or move of a domain. The best method is to perform a Key Signing Key (KSK) plus Zone Signing Key (ZSK) rollover. If that is not possible, the method using an unsigned intermediate state described in this document can be used to move the domain between two parties. This leaves the domain temporarily unsigned and vulnerable to DNS spoofing, but that is preferred over the alternative of validation failures due to a mismatched DS and DNSKEY record.",{"title":1358,"subseries":1359,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1360,"obsoleted_by":1361,"updates":1362,"updated_by":1363,"authors":1364,"published":1367,"identifiers":1368,"area":1371,"group":1372,"keywords":1375,"pages":294,"abstract":1379},"Edwards-Curve Digital Security Algorithm (EdDSA) for DNSSEC",[],[],[],[],[],[1365,1366],"O. Sury","R. Edmonds","2017-02-14",[1369],{"type":120,"value":1370},"10.17487\u002FRFC8080",{"acronym":153,"name":154},{"acronym":1373,"name":1374},"curdle","CURves, Deprecating and a Little more Encryption",[7,1376,1377,1378],"EdDSA","ed25519","ed448","This document describes how to specify Edwards-curve Digital Security Algorithm (EdDSA) keys and signatures in DNS Security (DNSSEC).  It uses EdDSA with the choice of two curves: Ed25519 and Ed448.",{"title":1381,"subseries":1382,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1383,"obsoleted_by":1384,"updates":1385,"updated_by":1386,"authors":1388,"published":1390,"identifiers":1391,"area":1394,"group":1395,"keywords":1396,"pages":1398,"abstract":1399},"Signaling Trust Anchor Knowledge in DNS Security Extensions (DNSSEC)",[],[],[],[],[1387],8553,[1389,1203,903],"D. Wessels","2017-04-11",[1392],{"type":120,"value":1393},"10.17487\u002FRFC8145",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1397],"Trust Anchor",13,"The DNS Security Extensions (DNSSEC) were developed to provide origin authentication and integrity protection for DNS data by using digital signatures.  These digital signatures can be verified by building a chain of trust starting from a trust anchor and proceeding down to a particular node in the DNS.  This document specifies two different ways for validating resolvers to signal to a server which keys are referenced in their chain of trust.  The data from such signaling allow zone administrators to monitor the progress of rollovers in a DNSSEC-signed zone.",{"title":1401,"subseries":1402,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1403,"obsoleted_by":1404,"updates":1405,"updated_by":1406,"authors":1407,"published":1410,"identifiers":1411,"area":1414,"group":1415,"keywords":1416,"pages":1398,"abstract":1419},"Aggressive Use of DNSSEC-Validated Cache",[],[],[],[192],[549],[1408,1409,1203],"K. Fujiwara","A. Kato","2017-07-25",[1412],{"type":120,"value":1413},"10.17487\u002FRFC8198",{"acronym":123,"name":124},{"acronym":126,"name":127},[1417,1418,1145,1146],"Negative cache","NCACHE","The DNS relies upon caching to scale; however, the cache lookup generally requires an exact match. This document specifies the use of NSEC\u002FNSEC3 resource records to allow DNSSEC-validating resolvers to generate negative answers within a range and positive answers from wildcards. This increases performance, decreases latency, decreases resource utilization on both authoritative and recursive servers, and increases privacy. Also, it may help increase resilience to certain DoS attacks in some circumstances.\n\n This document updates RFC 4035 by allowing validating resolvers to generate negative answers based upon NSEC\u002FNSEC3 records and positive answers in the presence of wildcards.",{"title":1421,"subseries":1422,"status":317,"status_name":318,"stream":1130,"stream_name":1131,"obsoletes":1423,"obsoleted_by":1424,"updates":1425,"updated_by":1426,"authors":1427,"published":1432,"identifiers":1433,"area":413,"group":1436,"keywords":1437,"pages":1440,"abstract":1441},"Yeti DNS Testbed",[],[],[],[],[],[1428,1429,1430,1409,1431],"L. Song","D. Liu","P. Vixie","S. Kerr","2018-10-19",[1434],{"type":120,"value":1435},"10.17487\u002FRFC8483",{"acronym":415,"name":416},[1438,7,1439],"Root Server","IPv6",39,"Yeti DNS is an experimental, non-production root server testbed that provides an environment where technical and operational experiments can safely be performed without risk to production root server infrastructure.  This document aims solely to document the technical and operational experience of deploying a system that is similar to but different from the Root Server system (on which the Internet's Domain Name System is designed and built).",{"title":1443,"subseries":1444,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1445,"obsoleted_by":1446,"updates":1447,"updated_by":1448,"authors":1449,"published":1452,"identifiers":1453,"area":1456,"group":1457,"keywords":1458,"pages":1337,"abstract":1464},"A Root Key Trust Anchor Sentinel for DNSSEC",[],[],[],[],[],[1450,1451,1203],"G. Huston","J. Damas","2018-12-18",[1454],{"type":120,"value":1455},"10.17487\u002FRFC8509",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1318,1459,129,1460,1461,1462,1463,255],"RFC5011","rollover","root-key-sentinel-is-ta-","root-key-sentinel-not-ta-","root key","The DNS Security Extensions (DNSSEC) were developed to provide origin authentication and integrity protection for DNS data by using digital signatures.  These digital signatures can be verified by building a chain of trust starting from a trust anchor and proceeding down to a particular node in the DNS.  This document specifies a mechanism that will allow an end user and third parties to determine the trusted key state for the root key of the resolvers that handle that user's DNS queries.  Note that this method is only applicable for determining which keys are in the trust store for the root key.",{"title":1466,"subseries":1467,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1468,"obsoleted_by":1469,"updates":1471,"updated_by":1472,"authors":1473,"published":1474,"identifiers":1475,"area":1478,"group":1479,"keywords":1480,"pages":183,"abstract":1481},"Algorithm Implementation Requirements and Usage Guidance for DNSSEC",[],[225],[1470],9904,[],[818],[1176,1365],"2019-06-11",[1476],{"type":120,"value":1477},"10.17487\u002FRFC8624",{"acronym":123,"name":124},{"acronym":126,"name":127},[],"The DNSSEC protocol makes use of various cryptographic algorithms in order to provide authentication of DNS data and proof of nonexistence.  To ensure interoperability between DNS resolvers and DNS authoritative servers, it is necessary to specify a set of algorithm implementation requirements and usage guidelines to ensure that there is at least one algorithm that all implementations support.  This document defines the current algorithm implementation requirements and usage guidance for DNSSEC.  This document obsoletes RFC 6944.",{"title":1483,"subseries":1484,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1485,"obsoleted_by":1486,"updates":1487,"updated_by":1488,"authors":1489,"published":1491,"identifiers":1492,"area":1495,"group":1496,"keywords":1499,"pages":1506,"abstract":1507},"Additional Deployment Guidelines for NAT64\u002F464XLAT in Operator and Enterprise Networks",[],[],[],[],[],[1490],"J. Palet Martinez","2019-11-26",[1493],{"type":120,"value":1494},"10.17487\u002FRFC8683",{"acronym":123,"name":124},{"acronym":1497,"name":1498},"v6ops","IPv6 Operations",[1439,7,1500,1501,1502,1503,1504,1505],"NAT64","DNS64","464XLAT","CLAT","NAT46","PLAT",38,"This document describes how Network Address and Protocol Translation from IPv6 Clients to IPv4 Servers (NAT64) (including 464XLAT) can be deployed in an IPv6 network -- whether it's cellular ISP, broadband ISP, or enterprise -- and the possible optimizations.  This document also discusses issues to be considered when having IPv6-only connectivity, such as: a) DNS64, b) applications or devices that use literal IPv4 addresses or non-IPv6-compliant APIs, and c) IPv4-only hosts or applications.",{"title":1509,"subseries":1510,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1511,"obsoleted_by":1512,"updates":1513,"updated_by":1514,"authors":1515,"published":1517,"identifiers":1518,"area":1521,"group":1522,"keywords":1523,"pages":236,"abstract":1525},"Moving DNSSEC Lookaside Validation (DLV) to Historic Status",[],[],[],[1155,524],[],[1012,1516],"D. Mahoney","2020-03-27",[1519],{"type":120,"value":1520},"10.17487\u002FRFC8749",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1524],"DLV","This document retires DNSSEC Lookaside Validation (DLV) and reclassifies RFCs 4431 and 5074 as Historic.  Furthermore, this document updates RFC 6698 by excluding the DLV resource record from certificates and updates RFC 6840 by excluding the DLV registries from the trust anchor selection.",{"title":1527,"subseries":1528,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1529,"obsoleted_by":1530,"updates":1531,"updated_by":1532,"authors":1533,"published":1537,"identifiers":1538,"area":1541,"group":1542,"keywords":1543,"pages":1398,"abstract":1548},"Multi-Signer DNSSEC Models",[],[],[],[],[],[1534,1535,1226,1536,725],"S. Huque","P. Aras","J. Vcelak","2020-09-24",[1539],{"type":120,"value":1540},"10.17487\u002FRFC8901",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1544,1545,1546,1547],"Multiple","Provider","Signer","Models","Many enterprises today employ the service of multiple DNS providers to distribute their authoritative DNS service.  Deploying DNSSEC in such an environment may present some challenges, depending on the configuration and feature set in use.  In particular, when each DNS provider independently signs zone data with their own keys, additional key-management mechanisms are necessary.  This document presents deployment models that accommodate this scenario and describes these key-management requirements.  These models do not require any changes to the behavior of validating resolvers, nor do they impose the new key-management requirements on authoritative servers not involved in multi-signer configurations.",{"title":1550,"subseries":1551,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1552,"obsoleted_by":1553,"updates":1554,"updated_by":1555,"authors":1556,"published":1559,"identifiers":1560,"area":1563,"group":1564,"keywords":1565,"pages":1234,"abstract":1569},"Message Digest for DNS Zones",[],[],[],[],[],[1389,1557,1558,1203,684],"P. Barber","M. Weinberg","2021-02-09",[1561],{"type":120,"value":1562},"10.17487\u002FRFC8976",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1566,1567,1568],"Checksum","Hash","Zone Transfer","This document describes a protocol and new DNS Resource Record that provides a cryptographic message digest over DNS zone data at rest. The ZONEMD Resource Record conveys the digest data in the zone itself. When used in combination with DNSSEC, ZONEMD allows recipients to verify the zone contents for data integrity and origin authenticity. This provides assurance that received zone data matches published data, regardless of how the zone data has been transmitted and received. When used without DNSSEC, ZONEMD functions as a checksum, guarding only against unintentional changes.\n\n ZONEMD does not replace DNSSEC: DNSSEC protects individual RRsets (DNS data with fine granularity), whereas ZONEMD protects a zone's data as a whole, whether consumed by authoritative name servers, recursive name servers, or any other applications.\n\n As specified herein, ZONEMD is impractical for large, dynamic zones due to the time and resources required for digest calculation. However, the ZONEMD record is extensible so that new digest schemes may be added in the future to support large, dynamic zones.",{"title":1571,"subseries":1572,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1573,"obsoleted_by":1574,"updates":1575,"updated_by":1576,"authors":1577,"published":1579,"identifiers":1580,"area":1583,"group":1584,"keywords":1585,"pages":496,"abstract":1587},"NSEC and NSEC3: TTLs and Aggressive Use",[],[],[],[191,192,1030,568],[],[1578],"P. van Dijk","2021-07-23",[1581],{"type":120,"value":1582},"10.17487\u002FRFC9077",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1586,1144],"negative cache","Due to a combination of unfortunate wording in earlier documents, aggressive use of NSEC and NSEC3 records may deny the existence of names far beyond the intended lifetime of a denial.  This document changes the definition of the NSEC and NSEC3 TTL to correct that situation.  This document updates RFCs 4034, 4035, 5155, and 8198.",{"title":1589,"subseries":1590,"status":299,"status_name":300,"stream":1130,"stream_name":1131,"obsoletes":1591,"obsoleted_by":1592,"updates":1593,"updated_by":1594,"authors":1595,"published":1599,"identifiers":1600,"area":413,"group":1603,"keywords":1604,"pages":1605,"abstract":1606},"TLS DNSSEC Chain Extension",[],[],[],[],[],[1596,1534,1597,1176,1598],"V. Dukhovni","W. Toorop","M. Shore","2021-08-11",[1601],{"type":120,"value":1602},"10.17487\u002FRFC9102",{"acronym":415,"name":416},[],43,"This document describes an experimental TLS extension for the in-band transport of the complete set of records that can be validated by DNSSEC and that are needed to perform DNS-Based Authentication of Named Entities (DANE) of a TLS server. This extension obviates the need to perform separate, out-of-band DNS lookups. When the requisite DNS records do not exist, the extension conveys a denial-of-existence proof that can be validated.\n\n This experimental extension is developed outside the IETF and is published here to guide implementation of the extension and to ensure interoperability among implementations.",{"title":1608,"subseries":1609,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1610,"obsoleted_by":1611,"updates":1612,"updated_by":1613,"authors":1614,"published":1615,"identifiers":1616,"area":1619,"group":1620,"keywords":1621,"pages":935,"abstract":1622},"Revised IANA Considerations for DNSSEC",[],[],[],[1030,523,1094],[1470],[903],"2021-12-01",[1617],{"type":120,"value":1618},"10.17487\u002FRFC9157",{"acronym":123,"name":124},{"acronym":126,"name":127},[],"This document changes the review requirements needed to get DNSSEC algorithms and resource records added to IANA registries.  It updates RFC 6014 to include hash algorithms for Delegation Signer (DS) records and NextSECure version 3 (NSEC3) parameters (for Hashed Authenticated Denial of Existence).  It also updates RFCs 5155 and 6014, which have requirements for DNSSEC algorithms, and updates RFC 8624 to clarify the implementation recommendation related to the algorithms described in RFCs that are not on the standards track.  The rationale for these changes is to bring the requirements for DS records and hash algorithms used in NSEC3 in line with the requirements for all other DNSSEC algorithms.",{"title":1624,"subseries":1625,"status":107,"status_name":108,"stream":109,"stream_name":109,"obsoletes":1627,"obsoleted_by":1628,"updates":1629,"updated_by":1630,"authors":1631,"published":1632,"identifiers":1633,"area":1636,"group":1637,"keywords":1638,"pages":275,"abstract":1639},"Guidance for NSEC3 Parameter Settings",[1626],"bcp236",[],[],[1030],[],[684,1596],"2022-08-11",[1634],{"type":120,"value":1635},"10.17487\u002FRFC9276",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,129,1146,1145,1144],"NSEC3 is a DNSSEC mechanism providing proof of nonexistence by asserting that there are no names that exist between two domain names within a zone.  Unlike its counterpart NSEC, NSEC3 avoids directly disclosing the bounding domain name pairs.  This document provides guidance on setting NSEC3 parameters based on recent operational deployment experience.  This document updates RFC 5155 with guidance about selecting NSEC3 iteration and salt parameters.",{"title":1641,"subseries":1642,"status":107,"status_name":108,"stream":109,"stream_name":109,"obsoletes":1644,"obsoleted_by":1645,"updates":1646,"updated_by":1647,"authors":1648,"published":1649,"identifiers":1650,"area":1653,"group":1654,"keywords":1655,"pages":275,"abstract":1657},"DNS Security Extensions (DNSSEC)",[1643],"bcp237",[],[],[],[],[903],"2023-02-14",[1651],{"type":120,"value":1652},"10.17487\u002FRFC9364",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1656,129],"DNS Security Extensions","This document describes the DNS Security Extensions (commonly called \"DNSSEC\") that are specified in RFCs 4033, 4034, and 4035, as well as a handful of others.  One purpose is to introduce all of the RFCs in one place so that the reader can understand the many aspects of DNSSEC.  This document does not update any of those RFCs.  A second purpose is to state that using DNSSEC for origin authentication of DNS data is the best current practice.  A third purpose is to provide a single reference for other documents that want to refer to DNSSEC.",{"title":1659,"subseries":1660,"status":317,"status_name":318,"stream":1130,"stream_name":1131,"obsoletes":1661,"obsoleted_by":1662,"updates":1663,"updated_by":1664,"authors":1665,"published":1667,"identifiers":1668,"area":413,"group":1671,"keywords":1672,"pages":362,"abstract":1673},"Use of GOST 2012 Signature Algorithms in DNSKEY and RRSIG Resource Records for DNSSEC",[],[],[],[],[],[1666,883],"B. Makarenko","2024-04-11",[1669],{"type":120,"value":1670},"10.17487\u002FRFC9558",{"acronym":415,"name":416},[],"This document describes how to produce digital signatures and hash functions using the GOST R 34.10-2012 and GOST R 34.11-2012 algorithms for DNSKEY, RRSIG, and DS resource records, for use in the Domain Name System Security Extensions (DNSSEC).",{"title":1675,"subseries":1676,"status":317,"status_name":318,"stream":1130,"stream_name":1131,"obsoletes":1677,"obsoleted_by":1678,"updates":1679,"updated_by":1680,"authors":1681,"published":1687,"identifiers":1688,"area":413,"group":1691,"keywords":1692,"pages":362,"abstract":1693},"SM2 Digital Signature Algorithm for DNSSEC",[],[],[],[],[],[1682,1683,1684,1685,1686],"C. Zhang","Y. Liu","F. Leng","Q. Zhao","Z. He","2024-12-04",[1689],{"type":120,"value":1690},"10.17487\u002FRFC9563",{"acronym":415,"name":416},[],"This document specifies the use of the SM2 digital signature algorithm and SM3 hash algorithm for DNS Security (DNSSEC).\n\n This document is an Independent Submission to the RFC series and does not have consensus of the IETF community.",{"title":1695,"subseries":1696,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1697,"obsoleted_by":1698,"updates":1699,"updated_by":1700,"authors":1701,"published":1703,"identifiers":1704,"area":1707,"group":1708,"keywords":1709,"pages":1711,"abstract":1712},"Automatic DNSSEC Bootstrapping Using Authenticated Signals from the Zone's Operator",[],[],[],[1345,1199],[],[116,1702],"N. Wisiol","2024-07-16",[1705],{"type":120,"value":1706},"10.17487\u002FRFC9615",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,1710,130,1214,1215],"bootstrapping",12,"This document introduces an in-band method for DNS operators to publish arbitrary information about the zones for which they are authoritative, in an authenticated fashion and on a per-zone basis. The mechanism allows managed DNS operators to securely announce DNSSEC key parameters for zones under their management, including for zones that are not currently securely delegated.\n\n Whenever DS records are absent for a zone's delegation, this signal enables the parent's registry or registrar to cryptographically validate the CDS\u002FCDNSKEY records found at the child's apex. The parent can then provision DS records for the delegation without resorting to out-of-band validation or weaker types of cross-checks such as \"Accept after Delay\".\n\n This document establishes the DS enrollment method described in Section 4 of this document as the preferred method over those from Section 3 of RFC 8078. It also updates RFC 7344.",{"title":1301,"subseries":1714,"status":317,"status_name":318,"stream":109,"stream_name":109,"obsoletes":1715,"obsoleted_by":1717,"updates":1718,"updated_by":1719,"authors":1720,"published":1721,"identifiers":1722,"area":1725,"group":1726,"keywords":1727,"pages":1398,"abstract":1728},[],[1716],7958,[],[],[],[1269,489,1309,903],"2025-01-24",[1723],{"type":120,"value":1724},"10.17487\u002FRFC9718",{"acronym":123,"name":124},{"acronym":126,"name":127},[1318],"The root zone of the global Domain Name System (DNS) is cryptographically signed using DNS Security Extensions (DNSSEC).\n\n In order to obtain secure answers from the root zone of the DNS using DNSSEC, a client must configure a suitable trust anchor. This document describes the format and publication mechanisms IANA uses to distribute the DNSSEC trust anchors.\n\n This document obsoletes RFC 7958.",{"title":1730,"subseries":1731,"status":107,"status_name":108,"stream":109,"stream_name":109,"obsoletes":1733,"obsoleted_by":1734,"updates":1735,"updated_by":1736,"authors":1737,"published":1740,"identifiers":1741,"area":1744,"group":1745,"keywords":1748,"pages":749,"abstract":1754},"Operational Considerations for Use of DNS in Internet of Things (IoT) Devices",[1732],"bcp241",[],[],[],[],[1738,1739],"M. Richardson","W. Pan","2025-03-31",[1742],{"type":120,"value":1743},"10.17487\u002FRFC9726",{"acronym":123,"name":124},{"acronym":1746,"name":1747},"opsawg","Operations and Management Area Working Group",[129,1749,1750,1751,7,1752,1753],"MUD","round-robin","tailored response","IoT security","Device Identity","This document details considerations about how Internet of Things (IoT) devices use IP addresses and DNS names. These concerns become acute as network operators begin deploying Manufacturer Usage Descriptions (MUD), as specified in RFC 8520, to control device access.\n\n Also, this document makes recommendations on when and how to use DNS names in MUD files.",{"title":1756,"subseries":1757,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1758,"obsoleted_by":1759,"updates":1760,"updated_by":1761,"authors":1762,"published":1764,"identifiers":1765,"area":1768,"group":1769,"keywords":1770,"pages":793,"abstract":1777},"Compact Denial of Existence in DNSSEC",[],[],[],[191,192],[],[1534,1763,266],"C. Elmerot","2025-09-18",[1766],{"type":120,"value":1767},"10.17487\u002FRFC9824",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1144,1771,1772,1773,1774,1775,1776],"Compact Denial of Existence","Compact Answers","Black Lies","NXDOMAIN","NODATA","Empty Non-Terminal","This document describes a technique to generate a signed DNS response on demand for a nonexistent name by claiming that the name exists but doesn't have any data for the queried record type. Such responses require only one minimally covering NSEC or NSEC3 record, allow online signing servers to minimize signing operations and response sizes, and prevent zone content disclosure.\n\n This document updates RFCs 4034 and 4035.",{"title":1779,"subseries":1780,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1781,"obsoleted_by":1782,"updates":1783,"updated_by":1784,"authors":1785,"published":1788,"identifiers":1789,"area":1792,"group":1793,"keywords":1794,"pages":1259,"abstract":1797},"Generalized DNS Notifications",[],[],[],[],[],[1786,116,1787],"J. Stenstam","J. Levine","2025-09-28",[1790],{"type":120,"value":1791},"10.17487\u002FRFC9859",{"acronym":123,"name":124},{"acronym":126,"name":127},[1795,1796,130,7],"Delegation","Automation","This document generalizes and extends the use of DNS NOTIFY (RFC 1996) beyond conventional zone transfer hints to allow other types of actions that were previously lacking a trigger mechanism to be triggered via the DNS. Notifications merely nudge the receiver to initiate a predefined action promptly (instead of on a schedule); they do not alter the action itself (including any security checks it might employ).\n\n To enable this functionality, a method for discovering the receiver endpoint for such notification messages is introduced, via the new DSYNC record type. Notification types are recorded in a new registry, with initial support for parental NS and DS record updates including DNSSEC bootstrapping.",{"title":1799,"subseries":1800,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1801,"obsoleted_by":1802,"updates":1803,"updated_by":1804,"authors":1805,"published":1806,"identifiers":1807,"area":1810,"group":1811,"keywords":1812,"pages":1398,"abstract":1814},"DNSSEC Cryptographic Algorithm Recommendation Update Process",[],[1094],[],[818],[],[684,1203],"2025-11-30",[1808],{"type":120,"value":1809},"10.17487\u002FRFC9904",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1460,1813],"agility","The DNSSEC protocol makes use of various cryptographic algorithms to provide authentication of DNS data and proof of nonexistence. To ensure interoperability between DNS resolvers and DNS authoritative servers, it is necessary to specify both a set of algorithm implementation requirements and usage guidelines to ensure that there is at least one algorithm that all implementations support. This document replaces and obsoletes RFC 8624 and moves the canonical source of algorithm implementation requirements and usage guidance for DNSSEC from RFC 8624 to the IANA DNSSEC algorithm registries. This is done to allow the list of requirements to be more easily updated and referenced. Extensions to these registries can be made in future RFCs. This document also updates RFC 9157 and incorporates the revised IANA DNSSEC considerations from that RFC.\n\n This document does not change the recommendation status (MUST, MAY, RECOMMENDED, etc.) of the algorithms listed in RFC 8624; that is the work of future documents.",{"title":1816,"subseries":1817,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1818,"obsoleted_by":1819,"updates":1820,"updated_by":1821,"authors":1822,"published":1806,"identifiers":1823,"area":1826,"group":1827,"keywords":1828,"pages":935,"abstract":1831},"Deprecating the Use of SHA-1 in DNSSEC Signature Algorithms",[],[],[],[191,1030],[],[684,1203],[1824],{"type":120,"value":1825},"10.17487\u002FRFC9905",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1460,1813,1829,1830],"algorithm","SHA1","This document deprecates the use of the RSASHA1 and\nRSASHA1-NSEC3-SHA1 algorithms for the creation of DNS Public Key\n(DNSKEY) and Resource Record Signature (RRSIG) records.\n\n It updates RFCs 4034 and 5155 as it deprecates the use of these\nalgorithms.",{"title":1833,"subseries":1834,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1835,"obsoleted_by":1836,"updates":1837,"updated_by":1838,"authors":1839,"published":1806,"identifiers":1840,"area":1843,"group":1844,"keywords":1845,"pages":935,"abstract":1847},"Deprecate Usage of ECC-GOST within DNSSEC",[],[],[],[],[],[684,1203],[1841],{"type":120,"value":1842},"10.17487\u002FRFC9906",{"acronym":123,"name":124},{"acronym":126,"name":127},[129,7,1846,1829,1460,1813],"GOST","This document retires the use of GOST R 34.10-2001 (mnemonic \"ECC-GOST\") and GOST R 34.11-94 within DNSSEC.\n\n RFC 5933 (Historic) defined the use of GOST R 34.10-2001 and GOST R 34.11-94 algorithms with DNS Security Extensions (DNSSEC). This document updates RFC 5933 by deprecating the use of ECC-GOST.",{"title":1849,"subseries":1850,"status":136,"status_name":137,"stream":109,"stream_name":109,"obsoletes":1851,"obsoleted_by":1852,"updates":1853,"updated_by":1855,"authors":1856,"published":1857,"identifiers":1858,"area":1861,"group":1862,"keywords":1863,"pages":1259,"abstract":1866},"Clarifications on CDS\u002FCDNSKEY and CSYNC Consistency",[],[],[],[1345,1854],7477,[],[116],"2026-05-26",[1859],{"type":120,"value":1860},"10.17487\u002FRFC9975",{"acronym":123,"name":124},{"acronym":126,"name":127},[7,130,1214,1215,1864,1865],"CSYNC","automation","Maintenance of DNS delegations requires occasional changes of the DS and NS record sets on the parent side of the delegation. For the case of DS records, \"Automating DNSSEC Delegation Trust Maintenance\" (RFC 7344) provides automation by allowing the child to publish CDS and\u002For CDNSKEY records holding the prospective DS parameters that the parent can ingest. Similarly, \"Child-to-Parent Synchronization in DNS\" (RFC 7477) specifies CSYNC records to indicate a desired update of the delegation's NS (and glue) records. Parent-side entities (e.g., Registries and Registrars) can query these records from the child and, after validation, use them to update the parent-side Resource Record Sets (RRsets) of the delegation.\n\nThis document specifies under which conditions the target states expressed via CDS\u002FCDNSKEY and CSYNC records are considered \"consistent\". Parent-side entities accepting such records from the child have to ensure that update requests retrieved from different authoritative nameservers satisfy these consistency requirements before taking any action based on them.\n\nThis document updates RFCs 7344 and 7477.",{"ancestors":1868,"descendants":1877},[1869,1873],{"slug":1870,"name":1870,"description":1871,"document_count":559,"document_count_deep":1872},"naming","Naming and name resolution in general, not specific to one system",650,{"slug":9,"name":129,"description":1874,"document_count":1875,"document_count_deep":1876},"DNS (Domain Name System): protocol, resource records, resolver and server behaviour, operations",298,441,[],["Reactive",1879],{"$scolor-mode":1880},{"preference":334,"value":334,"unknown":1881,"forced":12},true,["Set"],["ShallowReactive",1884],{"subject:dnssec":-1},"\u002Fsubjects\u002Fdnssec\u002F",["Reactive",1887],{"notifications":1888,"uiSettings":1894,"auth":1908,"reefSurveys":1914,"reef":1921},{"queue":1889,"dismissedIds":1892},["Ref",1890],["Reactive",1891],[],["skipHydrate",1893],1,{"isUiSettingsModalOpen":1895,"obsoletedByMode":1897,"updatedByMode":1899,"disableRFCLinkPreview":1900,"textScale":1901,"subjectDensity":1903,"subjectDocumentDensity":1905,"wordBreakMode":1906},["EmptyRef",1896],"false",["Ref",1898],"compact",["Ref",1898],["EmptyRef",1896],["Ref",1902],1.5,["Ref",1904],"full",["Ref",1904],["Ref",1907],"wbr",{"hasCheckedAuth":1909,"isAuthenticated":1910,"user":1911,"returnTo":1913},["EmptyRef",1896],["EmptyRef",1896],["EmptyRef",1912],"_",["EmptyRef",1912],{"surveys":1915,"status":1918,"isSurveysModalOpen":1920},["Ref",1916],["Reactive",1917],[],["Ref",1919],"idle",["EmptyRef",1896],{"ratings":1922,"subscriptions":1925,"pendingSubscriptions":1928,"setMembershipSync":1931,"sets":1934,"setIdsByDoc":1937,"status":1940,"subject":1946},["Ref",1923],["Reactive",1924],{},["Ref",1926],["Reactive",1927],[],["Ref",1929],["Reactive",1930],{},["Ref",1932],["Reactive",1933],{},["Ref",1935],["Reactive",1936],[],["Ref",1938],["Reactive",1939],{},["Ref",1941],["Reactive",1942],{"ratings":1943,"subscriptions":1944,"sets":1945},{"type":1919},{"type":1919},{"type":1919},["EmptyRef",1912]]</script></body></html>