er:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-5933-use-of-gost-signature-algorithms-in-dnskey-and-rrsig-resource-records-for-dnssec" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc5933/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">5933</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Use of GOST Signature Algorithms in DNSKEY and RRSIG Resource Records for DNSSEC</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Historic<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">V. Dolmatov<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">A. Chuprina<!--[--><!--]--></span></li><li class="inline"><span class