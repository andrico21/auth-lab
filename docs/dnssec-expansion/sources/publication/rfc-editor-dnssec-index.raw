rder-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-4035-protocol-modifications-for-the-dns-security-extensions" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc4035/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">4035</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Protocol Modifications for the DNS Security Extensions</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">R. Arends<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">R. Austein<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">M. Larson<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">D. Massey<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">S. Rose<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->March 2005</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-4035" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 4035"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-4035" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document is part of a family of documents that describe the DNS Security Extensions (DNSSEC). The DNS Security Extensions are a collection of new resource records and protocol modifications that add data origin authentication and data integrity to the DNS. This document describes the DNSSEC protocol modifications. This document defines the concept of a signed zone, along with the requirements for serving and resolving by using DNSSEC. These techniques allow a security-aware resolver to authenticate both DNS resource records and authoritative DNS error indications.</p><p></p><p> This document obsoletes RFC 2535 and incorporates changes from all updates to RFC 2535. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document is part of a family of documents that describe the DNS Security Extensions (DNSSEC). The DNS Security Extensions are a collection of new resource records and protocol modifications that add data origin authentication and data integrity to the DNS. This document describes the DNSSEC protocol modifications. This document defines the concept of a signed zone, along with the requirements for serving and resolving by using DNSSEC. These techniques allow a security-aware resolver to authenticate both DNS resource records and authoritative DNS error indications.</p><p></p><p> This document obsoletes RFC 2535 and incorporates changes from all updates to RFC 2535. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-pink-50 dark:bg-pink-950 border-pink-400 dark:border-pink-700 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-3845-dns-security-dnssec-nextsecure-nsec-rdata-format" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc3845/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">3845</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> DNS Security (DNSSEC) NextSECure (NSEC) RDATA Format</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">J. Schlyter<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->August 2004</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-3845" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 3845"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-3845" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document redefines the wire format of the &quot;Type Bit Map&quot; field in the DNS NextSECure (NSEC) resource record RDATA format to cover the full resource record (RR) type space. [STANDARDS-TRACK]</p><!--]--></div></div></div><p class="relative z-1 text-red-800 dark:text-red-300 text-base print:text-black"><ul class="inline-block">Obsoleted by <span class="inline-block p-1 -m-1">RFC <b>4033</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4034</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4035</b></span></ul></p></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document redefines the wire format of the &quot;Type Bit Map&quot; field in the DNS NextSECure (NSEC) resource record RDATA format to cover the full resource record (RR) type space. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-pink-50 dark:bg-pink-950 border-pink-400 dark:border-pink-700 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-3755-legacy-resolver-compatibility-for-delegation-signer-ds" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc3755/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">3755</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Legacy Resolver Compatibility for Delegation Signer (DS)</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">S. Weiler<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->May 2004</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-3755" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 3755"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-3755" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>As the DNS Security (DNSSEC) specifications have evolved, the syntax and semantics of the DNSSEC resource records (RRs) have changed.  Many deployed nameservers understand variants of these semantics.  Dangerous interactions can occur when a resolver that understands an earlier version of these semantics queries an authoritative server that understands the new delegation signer semantics, including at least one failure scenario that will cause an unsecured zone to be unresolvable.  This document changes the type codes and mnemonics of the DNSSEC RRs (SIG, KEY, and NXT) to avoid those interactions. [STANDARDS-TRACK]</p><!--]--></div></div></div><p class="relative z-1 text-red-800 dark:text-red-300 text-base print:text-black"><ul class="inline-block">Obsoleted by <span class="inline-block p-1 -m-1">RFC <b>4033</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4034</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4035</b></span></ul></p></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>As the DNS Security (DNSSEC) specifications have evolved, the syntax and semantics of the DNSSEC resource records (RRs) have changed.  Many deployed nameservers understand variants of these semantics.  Dangerous interactions can occur when a resolver that understands an earlier version of these semantics queries an authoritative server that understands the new delegation signer semantics, including at least one failure scenario that will cause an unsecured zone to be unresolvable.  This document changes the type codes and mnemonics of the DNSSEC RRs (SIG, KEY, and NXT) to avoid those interactions. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-pink-50 dark:bg-pink-950 border-pink-400 dark:border-pink-700 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-3757-domain-name-system-key-dnskey-resource-record-rr-secure-entry-point-sep-flag" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc3757/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">3757</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Domain Name System KEY (DNSKEY) Resource Record (RR) Secure Entry Point (SEP) Flag</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">O. Kolkman<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">J. Schlyter<!--[--><!--]--></span></li><li class="inline"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px]"></span><span class="whitespace-nowrap">E. Lewis<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->May 2004</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-3757" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 3757"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-3757" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>With the Delegation Signer (DS) resource record (RR), the concept of a public key acting as a secure entry point (SEP) has been introduced.  During exchanges of public keys with the parent there is a need to differentiate SEP keys from other public keys in the Domain Name System KEY (DNSKEY) resource record set.  A flag bit in the DNSKEY RR is defined to indicate that DNSKEY is to be used as a SEP.  The flag bit is intended to assist in operational procedures to correctly generate DS resource records, or to indicate what DNSKEYs are intended for static configuration.  The flag bit is not to be used in the DNS verification protocol.  This document updates RFC 2535 and RFC 3755. [STANDARDS-TRACK]</p><!--]--></div></div></div><p class="relative z-1 text-red-800 dark:text-red-300 text-base print:text-black"><ul class="inline-block">Obsoleted by <span class="inline-block p-1 -m-1">RFC <b>4033</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4034</b></span>, <span class="inline-block p-1 -m-1">RFC <b>4035</b></span></ul></p></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>With the Delegation Signer (DS) resource record (RR), the concept of a public key acting as a secure entry point (SEP) has been introduced.  During exchanges of public keys with the parent there is a need to differentiate SEP keys from other public keys in the Domain Name System KEY (DNSKEY) resource record set.  A flag bit in the DNSKEY RR is defined to indicate that DNSKEY is to be used as a SEP.  The flag bit is intended to assist in operational procedures to correctly generate DS resource records, or to indicate what DNSKEYs are intended for static configuration.  The flag bit is not to be used in the DNS verification protocol.  This document updates RFC 2535 and RFC 3755. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-3225-indicating-resolver-support-of-dnssec" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc3225/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">3225</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> Indicating Resolver Support of DNSSEC</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">D. Conrad<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->December 2001</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-3225" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 3225"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-3225" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>In order to deploy DNSSEC (Domain Name System Security Extensions) operationally, DNSSEC aware servers should only perform automatic inclusion of DNSSEC RRs when there is an explicit indication that the resolver can understand those RRs.  This document proposes the use of a bit in the EDNS0 header to provide that explicit indication and describes the necessary protocol changes to implement that notification. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>In order to deploy DNSSEC (Domain Name System Security Extensions) operationally, DNSSEC aware servers should only perform automatic inclusion of DNSSEC RRs when there is an explicit indication that the resolver can understand those RRs.  This document proposes the use of a bit in the EDNS0 header to provide that explicit indication and describes the necessary protocol changes to implement that notification. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold hover:bg-sky-100 focus:bg-sky-100 before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 1.996a7.49 7.49 0 0 1 7.496 7.25l.004.25v4.097l1.38 3.156a1.25 1.25 0 0 1-1.145 1.75L15 18.502a3 3 0 0 1-5.995.177L9 18.499H4.275a1.25 1.25 0 0 1-1.147-1.747L4.5 13.594V9.496c0-4.155 3.352-7.5 7.5-7.5M13.5 18.5l-3 .002a1.5 1.5 0 0 0 2.993.145zM12 3.496c-3.32 0-6 2.674-6 6v4.41L4.656 17h14.697L18 13.907V9.509l-.003-.225A5.99 5.99 0 0 0 12 3.496"></path></svg><span class="relative z-1">Subscribe</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li><li><div class="relative flex flex-row md:flex-row md:gap-2 px-2 py-1"><div><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm text-center md:text-left font-bold before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all text-blue-900 dark:text-blue-100 hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-25 dark:focus:text-blue-100 hover:before:bg-sky-100 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:border-1 after:border-white dark:after:border-black after:rounded hover:after:border-blue-800 dark:hover:after:border-blue-25 focus:after:outline-2 focus:after:outline-black gap-1"><!--[--><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewbox="0 0 24 24" aria-hidden="true" class="text-blue-900 dark:text-blue-100 w-[24px] h-[24px] sm:mr-1 relative z-1"><path fill="currentColor" d="M12 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12S6.477 2 12 2m0 1.5a8.5 8.5 0 1 0 0 17a8.5 8.5 0 0 0 0-17M12 7a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 12 7"></path></svg><span class="relative z-1">Add to Set</span><!--]--></button><!--v-if--><!--]--><!----></div></div></li></ul><!--]--><!--]--></div></li><li class="flex flex-col"><div class="bg-white dark:bg-blue-950 border-gray-200 dark:border-gray-500 relative border pl-5 pr-7 py-4 rounded shadow-xs print:border-2 print:border-black flex flex-col justify-between h-full"><!--[--><div class=""><h3 id="rfc-3226-dnssec-and-ipv-6-a-6-aware-serverresolver-message-size-requirements" class="text-xl font-semibold leading-[1.2] text-[22px] text-gray-800 dark:text-gray-200 font-feature-settings-calt-off group"><!----><!--[--><a href="/info/rfc3226/" class="font-semibold text-blue-300 dark:text-blue-100 print:text-black no-underline group before:absolute before:content-[&#39;&#39;] before:inset-0 before:rounded before:z-0 after:absolute after:content-[&#39;&#39;] after:inset-0 after:z-40 after:transition-all hover:text-blue-400 focus:text-blue-400 dark:hover:text-blue-100 dark:focus:text-blue-100 hover:before:bg-blue-25 focus:before:bg-blue-25 dark:hover:before:bg-blue-900 dark:focus:before:bg-blue-900 after:shadow-blue-950/10 dark:after:shadow-blue-100/10 hover:after:shadow-3xl focus:after:shadow-3xl dark:hover:after:shadow-3xl dark:hover:after:shadow-3xl after:rounded"><span class="relative z-1"><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">3226</span>:</span><!--]--><!--]--></span><!----><svg width="14" height="21" viewbox="0 0 11 7" xmlns="http://www.w3.org/2000/svg" class="motion-safe:transition-all absolute right-4 text-gray-200 group-hover:text-blue-400 group-focus:text-blue-400 dark:group-hover:text-blue-100 dark:group-focus:text-blue-100 transition-all group-hover:right-3 group-focus:right-3 -rotate-90 print:hidden bottom-[45%]" aria-hidden="true" fill="currentColor"><path d="M10.6262 1.34174L9.58022 0.334155C9.38658 0.14762 9.08009 0.14762 8.88645 0.334154L5.84688 3.26218C5.65324 3.44871 5.34676 3.44871 5.15312 3.26218L2.11355 0.334154C1.91991 0.14762 1.61342 0.14762 1.41978 0.334155L0.373816 1.34174C0.169662 1.5384 0.169662 1.86527 0.373816 2.06193L5.15311 6.66585C5.34676 6.85238 5.65324 6.85238 5.84688 6.66585L10.6262 2.06193C10.8303 1.86527 10.8303 1.5384 10.6262 1.34174Z"></path></svg></a><span class=""><!--[-->   <span></span><span class="relative z-3 font-normal"> DNSSEC and IPv6 A6 aware server/resolver message size requirements</span><!--]--></span><!--]--></h3><div class=""><!--[--><div class="md:pr-5 flex-1"><div class="inline-flex w-fit rounded-lg overflow-hidden print:text-sm print:leading-[2] relative z-1 print:m-0 text-xs font-semibold"><!--[--><div class="py-1 uppercase print:text-black print:bg-transparent print:border-1 print:border-black px-2 bg-blue-400 dark:bg-blue-800 text-white print:bg-white"><!--[-->Proposed Standard<!--]--></div><!--]--></div><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 dark:text-white"><!--[--><li class="inline"><!----><span class="whitespace-nowrap">O. Gudmundsson<!--[--><!--]--></span></li><!--]--></ul><ul class="relative z-1 hidden lg:block print:block text-base text-gray-800 mt-1 dark:text-white"><!----><!--[--><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><!---->December 2001</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>IETF publication</li><li class="inline text-[0.9rem] text-slate-600 dark:text-slate-200"><span class="inline-block mx-2 rotate-45 align-middle print:bg-black print:opacity-100 print-with-background bg-gray-600 dark:bg-white opacity-50 w-[5px] h-[5px] align-middle"></span>Internet Area</li><!--]--></ul><div class="block lg:hidden"><button type="button" aria-expanded="false" aria-controls="abstract-rfc-3226" class="relative z-50 text-blue-800 cursor-pointer dark:text-blue-100 underline text-base p-3 -ml-3 -mt-2 -mb-3 print:hidden" aria-label="Show abstract for RFC 3226"><!--[-->Show abstract<!--]--></button><div id="abstract-rfc-3226" class="relative z-50 mt-3 hidden print:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 pt-3 border-t inline-block group"><!----><!--[--> Abstract <!--]--></h4><div class="leading-snug text-gray-800 dark:text-gray-300 text-pretty"><!--[--><p>This document mandates support for EDNS0 (Extension Mechanisms for DNS) in DNS entities claiming to support either DNS Security Extensions or A6 records.  This requirement is necessary because these new features increase the size of DNS messages.  If EDNS0 is not supported fall back to TCP will happen, having a detrimental impact on query latency and DNS server load.  This document updates RFC 2535 and RFC 2874, by adding new requirements. [STANDARDS-TRACK]</p><!--]--></div></div></div><!----></div><div class="relative z-1 hidden lg:block"><h4 id="abstract" class="text-base font-semibold leading-[1.2] text-blue-900 dark:text-gray-300 inline-block mt-3 pt-2 border-t-1 border-gray-200 group"><!----><!--[--> Abstract <!--]--></h4><div class="pb-2 max-w-[34em] text-black dark:text-white leading-[1.5] text-pretty"><!--[--><p>This document mandates support for EDNS0 (Extension Mechanisms for DNS) in DNS entities claiming to support either DNS Security Extensions or A6 records.  This requirement is necessary because these new features increase the size of DNS messages.  If EDNS0 is not supported fall back to TCP will happen, having a detrimental impact on query latency and DNS server load.  This document updates RFC 2535 and RFC 2874, by adding new requirements. [STANDARDS-TRACK]</p><!--]--></div></div><!--]--></div></div><!----><!--[--><ul class="flex w-fit flex-row -ml-1 -mb-1 gap-4 z-50 py-1 px-1"><li><div class="relative flex flex-col md:flex-row md:gap-2 px-2 py-1"><div class="flex flex-col"><!--[--><button type="button" aria-haspopup="dialog" aria-expanded="false" data-state="closed" class="flex flex-col sm:flex-row items-center cursor-pointer rounded text-sm tex