<script type="text/javascript">
// Registry side nav: hierarchy, filtering, and scroll tracking.
(function () {
    "use strict";

    var nav = document.querySelector(".registry-nav");
    if (!nav) return;

    // Distance below the viewport top at which a section counts as current.
    var SCROLLSPY_LINE = 120;

    var items = Array.prototype.slice.call(nav.querySelectorAll(".registry-nav-item"));
    var toggles = Array.prototype.slice.call(nav.querySelectorAll(".registry-nav-toggle"));
    var filter = nav.querySelector("#registry-nav-filter");
    var status = nav.querySelector(".registry-nav-status");
    var clearFilter = nav.querySelector(".dtable-search__clear");

    function setExpanded(item, expanded) {
        var toggle = item.querySelector(":scope > .registry-nav-toggle");
        if (!toggle) return;
        item.classList.toggle("is-collapsed", !expanded);
        toggle.setAttribute("aria-expanded", expanded ? "true" : "false");
        var title = item.querySelector(":scope > a");
        toggle.setAttribute(
            "aria-label",
            (expanded ? "Collapse " : "Expand ") + (title ? title.getAttribute("data-title") : "")
        );
    }

    function ancestors(el) {
        var out = [];
        for (var p = el.parentElement; p && nav.contains(p); p = p.parentElement) {
            if (p.classList.contains("registry-nav-item")) out.push(p);
        }
        return out;
    }

    function revealItem(item) {
        ancestors(item).forEach(function (parent) {
            setExpanded(parent, true);
        });
    }

    // Branches start expanded; just wire up the toggles.

    toggles.forEach(function (toggle) {
        toggle.addEventListener("click", function () {
            var item = toggle.closest(".registry-nav-item");
            setExpanded(item, item.classList.contains("is-collapsed"));
        });
    });

    // ===== Phone and tablet drawer =====
    // The checkbox in the template already opens/closes the off-canvas nav
    // via CSS alone (see _apps.scss), so it works with no JavaScript
    // at all. This just layers on convenience: closing after a tap, Escape,
    // a resize past the breakpoint, and locking body scroll while it's open.

    // The element an in-page link points at. A fragment that isn't valid
    // percent-encoding (a stray "%") is looked up as written.
    function fragmentTarget(href) {
        if (!href || href.charAt(0) !== "#") return null;
        var id = href.slice(1);
        try {
            id = decodeURIComponent(id);
        } catch (e) {}
        return document.getElementById(id);
    }

    var mobileCheckbox = document.getElementById("registry-nav-checkbox");
    var NAV_DRAWER_QUERY = "(max-width: 1000px)"; // $breakpoint-lg in _apps.scss

    // Closing the drawer hides it (visibility: hidden), which would strand
    // focus inside it, so hand focus back to the toggle (its :focus-visible
    // ring shows on the label). Not past the breakpoint: there the nav is a
    // visible sidebar and focus can stay where it is. Not after following a
    // link either (keepFocus): focus goes to the chosen section instead.
    // Focus that is elsewhere on the page stays put; focus that is on nothing
    // (the body) goes to the toggle too.
    function setNavOpen(open, keepFocus) {
        var active = document.activeElement;
        var strandFocus = !open && !keepFocus && mobileCheckbox && mobileCheckbox.checked &&
            (!active || active === document.body || nav.contains(active)) &&
            window.matchMedia(NAV_DRAWER_QUERY).matches;
        if (mobileCheckbox) mobileCheckbox.checked = open;
        document.body.classList.toggle("registry-nav-open", open);
        if (strandFocus) mobileCheckbox.focus({preventScroll: true});
    }

    if (mobileCheckbox) {
        mobileCheckbox.addEventListener("change", function () {
            document.body.classList.toggle("registry-nav-open", mobileCheckbox.checked);
        });
    }

    // Closing after a tap lets the user actually see the section they picked.
    // Focus moves to that section too: left on the link, it would be stranded
    // in the hidden drawer, and a section that isn't focusable doesn't take
    // focus from the fragment navigation by itself. preventScroll leaves the
    // scrolling to the link's own navigation. A section made focusable only
    // for this loses its tabindex again once focus moves on. Modified clicks
    // (open in a new tab) navigate elsewhere, so the drawer stays as it is.
    // A link to a section that doesn't exist hands focus back to the toggle.
    nav.addEventListener("click", function (event) {
        var link = event.target.closest("a");
        if (!link || !window.matchMedia(NAV_DRAWER_QUERY).matches) return;
        if (event.defaultPrevented || event.button !== 0 ||
            event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        var section = fragmentTarget(link.getAttribute("href"));
        setNavOpen(false, !!section);
        if (section) {
            if (!section.hasAttribute("tabindex")) {
                section.setAttribute("tabindex", "-1");
                section.classList.add("registry-nav-target");
                section.addEventListener("blur", function () {
                    section.removeAttribute("tabindex");
                    section.classList.remove("registry-nav-target");
                }, {once: true});
            }
            section.focus({preventScroll: true});
        }
    });

    window.addEventListener("keydown", function (event) {
        if (event.key === "Escape" && mobileCheckbox && mobileCheckbox.checked) setNavOpen(false);
    });

    // A resize past the breakpoint (e.g. rotating the device) shouldn't
    // leave the drawer open with no toggle left to close it.
    window.addEventListener("resize", function () {
        if (!window.matchMedia(NAV_DRAWER_QUERY).matches) setNavOpen(false);
    });

    // ===== Filtering =====

    // Search only visible label text; the screen-reader-only elided prefix is excluded
    function labelNode(link) {
        var label = link.querySelector(".registry-nav-label");
        if (!label) return null;
        return Array.prototype.find.call(label.childNodes, function (node) {
            return node.nodeType === Node.TEXT_NODE && node.nodeValue.trim() !== "";
        });
    }

    function markMatch(link, term) {
        var node = labelNode(link);
        if (!node) return;
        var text = node.nodeValue;
        var at = text.toLowerCase().indexOf(term);
        if (at === -1) return;

        var mark = document.createElement("mark");
        mark.textContent = text.substr(at, term.length);
        var fragment = document.createDocumentFragment();
        fragment.appendChild(document.createTextNode(text.slice(0, at)));
        fragment.appendChild(mark);
        fragment.appendChild(document.createTextNode(text.slice(at + term.length)));
        node.parentNode.replaceChild(fragment, node);
    }

    function clearMarks() {
        Array.prototype.forEach.call(nav.querySelectorAll("mark"), function (mark) {
            var parent = mark.parentNode;
            mark.replaceWith(mark.textContent);
            parent.normalize();
        });
    }

    function applyFilter() {
        var term = filter.value.trim().toLowerCase();
        nav.classList.toggle("is-filtering", term !== "");
        if (clearFilter) clearFilter.hidden = !filter.value;
        clearMarks();

        if (!term) {
            items.forEach(function (item) {
                item.classList.remove("is-hidden", "is-match");
            });
            if (status) status.hidden = true;
            return;
        }

        var matched = 0;
        items.forEach(function (item) {
            var link = item.querySelector(":scope > a");
            var hit = link && link.getAttribute("data-title").toLowerCase().indexOf(term) !== -1;
            item.classList.toggle("is-match", !!hit);
            item.classList.add("is-hidden");
            if (!hit) return;
            markMatch(link, term);
            matched++;
        });
        // Keep a match's ancestors for context and children for navigation.
        items.forEach(function (item) {
            if (!item.classList.contains("is-match")) return;
            item.classList.remove("is-hidden");
            ancestors(item).forEach(function (parent) {
                parent.classList.remove("is-hidden");
                setExpanded(parent, true);
            });
            Array.prototype.forEach.call(item.querySelectorAll(".registry-nav-item"), function (child) {
                child.classList.remove("is-hidden");
            });
            setExpanded(item, true);
        });
        if (status) {
            status.hidden = false;
            status.textContent = matched === 0
                ? "No registries match your search"
                : matched + " of " + items.length + " registries match your search";
        }
    }

    if (filter) {
        filter.addEventListener("input", applyFilter);
        filter.addEventListener("keydown", function (event) {
            if (event.key !== "Escape" || !filter.value) return;
            filter.value = "";
            applyFilter();
            // This Escape only clears the filter; it shouldn't also close the drawer.
            event.stopPropagation();
        });
    }

    if (clearFilter) {
        clearFilter.addEventListener("click", function () {
            filter.value = "";
            applyFilter();
            filter.focus();
        });
    }

    // ===== Scroll tracking =====

    var sections = Array.prototype.map.call(
        nav.querySelectorAll('a[href^="#"]'),
        function (a) {
            return {link: a, target: fragmentTarget(a.getAttribute("href"))};
        }
    ).filter(function (s) {
        return s.target;
    });
    if (!sections.length) return;

    // Start from the link the server marked current, so it is unmarked when another section becomes active
    var current = nav.querySelector("a.is-current");

    var scroller = nav.querySelector(".registry-nav-scroll");

    // Gap left between the highlighted row and the edges it is kept clear of.
    var KEEP_VISIBLE_MARGIN = 4;

    // scrollIntoView({block: "nearest"}) parks the row underneath the sticky
    // head, which is painted over it, and it also scrolls the window. Scroll
    // the nav column by hand instead, measuring from the head's bottom edge.
    function keepVisible(link) {
        if (!scroller) return;
        var scrollRect = scroller.getBoundingClientRect();
        var head = scroller.querySelector(".registry-nav-head");
        var top = (head ? head.getBoundingClientRect().bottom : scrollRect.top) + KEEP_VISIBLE_MARGIN;
        var bottom = scrollRect.bottom - KEEP_VISIBLE_MARGIN;
        var linkRect = link.getBoundingClientRect();
        var delta = 0;

        if (linkRect.top < top) {
            delta = linkRect.top - top;
        } else if (linkRect.bottom > bottom) {
            // Never push the top of a tall row out of sight to reveal its end.
            delta = Math.min(linkRect.bottom - bottom, linkRect.top - top);
        }
        if (delta) scroller.scrollTop += delta;
    }

    function update() {
        var active = sections[0];
        for (var i = 0; i < sections.length; i++) {
            if (sections[i].target.getBoundingClientRect().top - SCROLLSPY_LINE <= 0) {
                active = sections[i];
            }
        }
        if (!active || active.link === current) return;

        if (current) {
            current.classList.remove("is-current");
            current.removeAttribute("aria-current");
            ancestors(current).forEach(function (parent) {
                parent.classList.remove("is-ancestor");
            });
        }
        active.link.classList.add("is-current");
        active.link.setAttribute("aria-current", "location");
        var item = active.link.closest(".registry-nav-item");
        // Open and mark the path to the current section.
        revealItem(item);
        ancestors(active.link).forEach(function (parent) {
            parent.classList.add("is-ancestor");
        });
        current = active.link;
        if (!nav.classList.contains("is-filtering")) {
            keepVisible(active.link);
        }
    }

    var ticking = false;

    function onScroll() {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(function () {
            update();
            ticking = false;
        });
    }

    window.addEventListener("scroll", onScroll, {passive: true});
    window.addEventListener("resize", onScroll);
    update();
})();

(function () {
    "use strict";

    var form = document.querySelector(".registry-content form");
    var input = form && form.querySelector('input[type="text"]');
    var submit = form && form.querySelector('input[type="submit"]');
    if (!form || !input) return;

    form.classList.add("dtable-search");
    input.type = "search";
    input.removeAttribute("size");
    input.setAttribute("autocomplete", "off");
    // The placeholder disappears once there is text, so it can't be the input's name.
    input.setAttribute("aria-label", "Search registry");
    if (!input.value) input.setAttribute("placeholder", "Search…");

    var icon = document.createElement("img");
    icon.src = "/static/icons/magnifying-glass.svg";
    icon.alt = "";
    icon.className = "dtable-search__icon";
    form.insertBefore(icon, input);

    if (submit) submit.className = "dtable-search__clear";
})();
</script>

<script type="text/javascript">
    (function () {
        "use strict";

        var collator;

        function hexList(text) {
            return (text.match(/[\dA-Fa-f]+/g) || []).map(function (hex) {
                return parseInt(hex, 16);
            });
        }

        function ipv6List(text) {
            var parts = text.split(/\s*-\s*/)[0].split("/");
            // The address is the first word, so a trailing annotation such as
            // "::1 (loopback)" doesn't count. Text that isn't an address at all
            // ("Reserved", "Note: see below", "Add: ...", empty) sorts together,
            // ahead of every prefix including ::/0. Every IPv6 address has at
            // least two colons, which rules out hex-looking words like "Add:".
            var address = parts[0].trim().split(/\s+/)[0];
            if (address.split(":").length < 3 || !/^[\dA-Fa-fXx:.]+$/.test(address)) return [-1];
            // 16-bit groups; a dotted IPv4 tail (::ffff:192.0.2.0) is two of them.
            function groupValues(groups) {
                var values = [];
                groups.split(":").forEach(function (group) {
                    if (!group) return;
                    var octets = group.split(".");
                    if (octets.length > 1) {
                        var bytes = [0, 1, 2, 3].map(function (i) {
                            return parseInt(octets[i], 10) || 0;
                        });
                        values.push(bytes[0] * 256 + bytes[1], bytes[2] * 256 + bytes[3]);
                    } else {
                        values.push(parseInt(group.replace(/X/gi, "0"), 16) || 0);
                    }
                });
                return values;
            }
            // Exactly eight groups so the prefix length always compares against
            // the prefix length: "::" takes the zeros, else they go at the end
            // (an abbreviated prefix like 2001:db8:0:0/64), and malformed extra
            // groups are dropped. A malformed second "::" is read as a ":".
            var halves = address.split("::");
            var values = groupValues(halves[0]);
            var tail = groupValues(halves.slice(1).join(":"));
            while (values.length + tail.length < 8) values.push(0);
            values = values.concat(tail).slice(0, 8);
            values.push(parseInt(parts[1], 10) || 0);
            return values;
        }

        function listCompare(a, b) {
            for (var i = 0; i < a.length && i < b.length; i++) {
                if (a[i] !== b[i]) return a[i] < b[i] ? -1 : 1;
            }
            return a.length - b.length;
        }

        var NUMERIC = {key: hexList, compare: listCompare};
        var IPV6 = {key: ipv6List, compare: listCompare};
        var TEXT = {
            key: function (text) { return text.replace(/^\W+/, "").toLowerCase(); },
            compare: function (a, b) {
                return (collator || (collator = new Intl.Collator())).compare(a, b);
            }
        };

        function cellText(row, index) {
            var cell = row.cells[index];
            return cell ? cell.textContent : "";
        }

        function columnType(rows, th, index) {
            if (th.classList.contains("sortNumeric")) return NUMERIC;
            if (th.classList.contains("sortIPv6")) return IPV6;
            for (var i = 0; i < rows.length; i++) {
                if (/\w/.test(cellText(rows[i], index).replace(/(0x)?[\dA-Fa-f]+/g, ""))) return TEXT;
            }
            return NUMERIC;
        }

        function sortTable(table, th, index) {
            var tbody = table.tBodies[0];
            if (!tbody) return;
            var rows = Array.prototype.slice.call(tbody.rows);
            var current = th.getAttribute("aria-sort");

            if (current === "ascending" || current === "descending") {
                rows.reverse();
                th.setAttribute("aria-sort", current === "ascending" ? "descending" : "ascending");
            } else {
                var type = th.sortType || (th.sortType = columnType(rows, th, index));
                rows = rows.map(function (row) {
                    return {key: type.key(cellText(row, index)), row: row};
                }).sort(function (a, b) {
                    return type.compare(a.key, b.key);
                }).map(function (entry) {
                    return entry.row;
                });
                Array.prototype.forEach.call(th.parentNode.cells, function (cell) {
                    cell.setAttribute("aria-sort", cell === th ? "ascending" : "none");
                });
            }

            // Emptying the body first makes the re-insert one DOM operation
            // instead of one move per row -- over ten times faster on large registries.
            var fragment = document.createDocumentFragment();
            tbody.textContent = "";
            rows.forEach(function (row) {
                fragment.appendChild(row);
            });
            tbody.appendChild(fragment);
        }

        var params = new URLSearchParams(location.search);
        var serverKeys = params.getAll("skey");

        function serverSort(column) {
            var ascending = String(column);
            var descending = String(-column);
            var next = serverKeys.filter(function (key) {
                return key !== ascending && key !== descending;
            });
            if (serverKeys.indexOf(ascending) !== -1) {
                next.push(descending);
            } else if (serverKeys.indexOf(descending) === -1) {
                next.push(ascending);
            }
            params.delete("page");
            params.delete("skey");
            next.forEach(function (key) {
                params.append("skey", key);
            });
            location.search = params.toString();
        }

        if (serverKeys.length) {
            Array.prototype.forEach.call(
                document.querySelectorAll("table.sortable_srv > thead > tr:first-child > th.dtable-sortable"),
                function (th) {
                    var column = th.cellIndex + 1;
                    serverKeys.forEach(function (key) {
                        if (key === String(column)) th.setAttribute("aria-sort", "ascending");
                        if (key === String(-column)) th.setAttribute("aria-sort", "descending");
                    });
                }
            );
        }

        // Returns whether th is a sort header (and was sorted), so a keypress
        // that sorted doesn't also scroll the page (Space).
        function activate(th) {
            var table = th && th.closest("table");
            if (!table || !table.tHead || th.parentNode !== table.tHead.rows[0]) return false;
            if (table.classList.contains("sortable_srv")) {
                serverSort(th.cellIndex + 1);
            } else {
                sortTable(table, th, th.cellIndex);
            }
            return true;
        }

        // A link beside the header text (e.g. a footnote) only follows the
        // link, by mouse or keyboard alike; the rest of the header, including
        // a bare <a name> anchor, sorts. A link that is the whole header text
        // would leave nothing to click, so a click there sorts instead; Enter
        // on it still follows it.
        document.addEventListener("click", function (event) {
            var target = event.target;
            if (!target.closest) return;
            var th = target.closest("th.dtable-sortable");
            var link = target.closest("th.dtable-sortable a[href]");
            if (link && th && link.textContent.trim() !== th.textContent.trim()) return;
            if (activate(th) && link) event.preventDefault();
        });
        // Only when the header itself has focus, which also keeps Enter on a
        // link inside it a plain link. Held keys and modified keys (browser
        // shortcuts like Shift+Space) are left alone.
        document.addEventListener("keydown", function (event) {
            if (event.key !== "Enter" && event.key !== " ") return;
            if (event.repeat || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
            if (!event.target.matches || !event.target.matches("th.dtable-sortable")) return;
            if (activate(event.target)) event.preventDefault();
        });
    })();
</script>

</body>

</html>
